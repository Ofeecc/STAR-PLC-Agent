MODULE main
VAR
  LowWet : boolean;
  HighWet : boolean;
  Inhibit : boolean;
  first : boolean;
  qFill : boolean;

ASSIGN
  init(first) := TRUE;
  next(first) := FALSE;
  init(qFill) := FALSE;
  next(qFill) := Fill;

DEFINE
  SensorFault := HighWet & !LowWet;
  middle := LowWet & !HighWet;
  Fill := !(SensorFault | Inhibit | HighWet) & (!LowWet | qFill);

LTLSPEC NAME P1 := G(SensorFault <-> (HighWet & !LowWet));
LTLSPEC NAME P2 := G((SensorFault | Inhibit | HighWet) -> !Fill);
LTLSPEC NAME P3 := G((!LowWet & !HighWet & !Inhibit) -> Fill);
LTLSPEC NAME P4 := G((middle & !Inhibit) -> (Fill <-> qFill));
LTLSPEC NAME P5 := G(first -> !qFill);
LTLSPEC NAME SPEC_complete := G((SensorFault <-> (HighWet & !LowWet)) & (Fill <-> (!(SensorFault | Inhibit | HighWet) & (!LowWet | qFill))));
