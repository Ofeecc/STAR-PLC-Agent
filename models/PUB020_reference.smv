-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB020 (Production Control), nuXmv infinite-state SMT model.
-- Abstraction note: weight and firingTemp use exact mathematical rational reals (500 + (weight - 100) * 0.5) without binary32 ULP rounding.
MODULE main
VAR
  Mode : boolean;
  ForwardButton : boolean;
  ReverseButton : boolean;
  SensorFeed : boolean;
  SensorWash : boolean;
  SensorWeight : boolean;
  SensorFiring : boolean;
  SensorOutput : boolean;
  washComplete : boolean;
  weightComplete : boolean;
  weight : real;
  firingComplete : boolean;

  phase : {WAIT_FEED, MOVE_WASH, WAIT_WASH, MOVE_WEIGHT, WAIT_WEIGHT, REJECT, MOVE_FIRING, WAIT_FIRING, MOVE_OUTPUT, OUTPUT_DONE};
  temp : real;

INIT phase = WAIT_FEED & temp = 0.0;

ASSIGN
  next(phase) := nextPhase;
  next(temp) := firingTemp;

DEFINE
  auto := Mode;
  mf := ForwardButton & !ReverseButton;
  mr := ReverseButton & !ForwardButton;
  valid_weight := weight >= 100.0 & weight <= 200.0;
  judged := auto & phase = WAIT_WEIGHT & SensorWeight & weightComplete;

  nextPhase := case
    !auto : WAIT_FEED;
    phase = WAIT_FEED & SensorFeed : MOVE_WASH;
    phase = MOVE_WASH & SensorWash : WAIT_WASH;
    phase = WAIT_WASH & SensorWash & washComplete : MOVE_WEIGHT;
    phase = MOVE_WEIGHT & SensorWeight : WAIT_WEIGHT;
    phase = WAIT_WEIGHT & SensorWeight & weightComplete : (valid_weight ? MOVE_FIRING : REJECT);
    phase = REJECT & !SensorWeight : WAIT_FEED;
    phase = MOVE_FIRING & SensorFiring : WAIT_FIRING;
    phase = WAIT_FIRING & SensorFiring & firingComplete : MOVE_OUTPUT;
    phase = MOVE_OUTPUT & SensorOutput : OUTPUT_DONE;
    phase = OUTPUT_DONE & !SensorOutput : WAIT_FEED;
    TRUE : phase;
  esac;

  firingTemp := (judged & valid_weight) ? (500.0 + (weight - 100.0) * 0.5) : temp;
  MotorForward := auto ? (nextPhase = MOVE_WASH | nextPhase = MOVE_WEIGHT | nextPhase = MOVE_FIRING | nextPhase = MOVE_OUTPUT) : mf;
  MotorReverse := auto ? FALSE : mr;
  kick := auto & (nextPhase = REJECT);
  CompletionLight := auto & (nextPhase = OUTPUT_DONE);

  arrival := auto & ((phase = MOVE_WASH & SensorWash) | (phase = MOVE_WEIGHT & SensorWeight) |
                     (phase = MOVE_FIRING & SensorFiring) | (phase = MOVE_OUTPUT & SensorOutput));
  stopped := !MotorForward & !MotorReverse;
  arrival_pending := phase = MOVE_WASH | phase = MOVE_WEIGHT | phase = MOVE_FIRING | phase = MOVE_OUTPUT;
  arrival_done := (phase = MOVE_WASH & SensorWash) | (phase = MOVE_WEIGHT & SensorWeight) |
                  (phase = MOVE_FIRING & SensorFiring) | (phase = MOVE_OUTPUT & SensorOutput);
  processing_wait := phase = WAIT_WASH | phase = WAIT_WEIGHT | phase = WAIT_FIRING;
  matching_completion := (phase = WAIT_WASH & SensorWash & washComplete) |
                         (phase = WAIT_WEIGHT & SensorWeight & weightComplete) |
                         (phase = WAIT_FIRING & SensorFiring & firingComplete);

INVARSPEC NAME P1 := !(MotorForward & MotorReverse);
INVARSPEC NAME P2 := !auto -> ((MotorForward <-> mf) & (MotorReverse <-> mr) & !kick & !CompletionLight & firingTemp = temp);
INVARSPEC NAME P3 := auto -> !MotorReverse;
INVARSPEC NAME P4 := (auto & arrival) -> stopped;
INVARSPEC NAME P5 := judged -> (valid_weight ? (!kick & MotorForward & firingTemp = 500.0 + (weight - 100.0) * 0.5) : (kick & stopped & firingTemp = temp));
INVARSPEC NAME P6 := (!judged | !valid_weight) -> (firingTemp = temp);
INVARSPEC NAME P7 := ((auto & phase = MOVE_OUTPUT & SensorOutput) -> CompletionLight) & ((auto & phase = OUTPUT_DONE & !SensorOutput) -> (!CompletionLight & stopped));
INVARSPEC NAME P8_safety := ((phase = REJECT) -> !CompletionLight) &
                             ((auto & phase = REJECT & SensorWeight) -> (nextPhase = REJECT)) &
                             ((auto & phase = REJECT & !SensorWeight) -> (nextPhase = WAIT_FEED)) &
                             ((auto & phase = REJECT) -> (nextPhase != MOVE_FIRING));
INVARSPEC NAME P10 := (!auto -> (!kick & !CompletionLight)) &
                      ((auto & (nextPhase = WAIT_FEED | nextPhase = WAIT_WASH | nextPhase = WAIT_WEIGHT | nextPhase = WAIT_FIRING)) -> stopped) &
                      ((auto & (nextPhase = MOVE_WASH | nextPhase = MOVE_WEIGHT | nextPhase = MOVE_FIRING | nextPhase = MOVE_OUTPUT)) -> (MotorForward & !MotorReverse));
LTLSPEC NAME P9 := (G (auto) & G (arrival_pending -> F arrival_done) & G (processing_wait -> F matching_completion) & G (judged -> valid_weight)) ->
                   G ((phase = WAIT_FEED & SensorFeed) -> F CompletionLight);
