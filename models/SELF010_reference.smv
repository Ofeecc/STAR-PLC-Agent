MODULE main
VAR
  Fault : boolean;
  Ack : boolean;
  Reset : boolean;
  first : boolean;
  qFault : boolean;
  qAlarm : boolean;
  qAck : boolean;

ASSIGN
  init(first) := TRUE;
  next(first) := FALSE;
  init(qFault) := FALSE;
  next(qFault) := Fault;
  init(qAlarm) := FALSE;
  next(qAlarm) := Alarm;
  init(qAck) := FALSE;
  next(qAck) := Acknowledged;

DEFINE
  validReset := Reset & !Fault;
  rise := Fault & !qFault;
  Alarm := !validReset & (Fault | qAlarm);
  Acknowledged := case
    validReset : FALSE;
    rise : FALSE;
    Ack & (Fault | qAlarm) : TRUE;
    TRUE : qAck;
  esac;
  Horn := Alarm & !Acknowledged;

LTLSPEC NAME P1 := G(Horn <-> (Alarm & !Acknowledged));
LTLSPEC NAME P2 := G(Fault -> Alarm);
LTLSPEC NAME P3 := G(rise -> (Alarm & !Acknowledged & Horn));
LTLSPEC NAME P4 := G((Reset & !Fault) -> (!Alarm & !Acknowledged & !Horn));
LTLSPEC NAME P5 := G((!Fault & !Reset & qAlarm) -> Alarm);
LTLSPEC NAME P6 := G((!rise & !(Reset & !Fault) & Ack & qAlarm) -> Acknowledged);
LTLSPEC NAME P7 := G((!Fault & !qAlarm) -> (!Alarm & !Acknowledged & !Horn));
LTLSPEC NAME P8 := G((qAlarm & !(Reset & !Fault) & !rise & !Ack) -> (Acknowledged <-> qAck));

-- Completeness additions: initial state, Ack during Fault & Reset, anti-spurious alarm/ack, holds, qFault iff
LTLSPEC NAME SPEC_init := first -> (!qFault & !qAlarm & !qAck);
LTLSPEC NAME SPEC_ack_during_fault_reset := G((!rise & Fault & Reset & Ack) -> Acknowledged);
LTLSPEC NAME SPEC_no_spurious_alarm := G((!Fault & !qAlarm) -> (!Alarm & !Acknowledged & !Horn));
LTLSPEC NAME SPEC_alarm_hold_without_reset := G((qAlarm & !validReset) -> Alarm);
LTLSPEC NAME SPEC_ack_hold := G((!validReset & !rise & qAck) -> Acknowledged);
LTLSPEC NAME SPEC_qfault_iff := G(X(qFault) <-> Fault);
