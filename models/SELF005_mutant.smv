-- Negative control mutant for SELF005: switches Green -> Amber after 1 tick instead of 3 ticks.
-- Original P1..P7 all hold (P5 becomes vacuous), while V2_green_duration_3 catches the short phase.
MODULE main
VAR
  Enable : boolean;
  Tick : boolean;
  qPhase : 0..2;
  qAge : 0..2;

ASSIGN
  init(qPhase) := 0;
  init(qAge) := 0;
  next(qPhase) := nextPhase;
  next(qAge) := nextAge;

DEFINE
  nextPhase := case
    !Enable : 0;
    !Tick : qPhase;
    qPhase = 0 & qAge = 1 : 1;
    qPhase = 1 : 2;
    qPhase = 2 : 0;
    TRUE : qPhase;
  esac;

  nextAge := case
    !Enable : 0;
    !Tick : qAge;
    qPhase = 0 & qAge = 1 : 0;
    qPhase = 1 : 0;
    qPhase = 2 : 0;
    qAge < 2 : qAge + 1;
    TRUE : 0;
  esac;

  Phase := nextPhase;
  Red := nextPhase = 0;
  Green := nextPhase = 1;
  Amber := nextPhase = 2;

  qRedLast := qPhase = 0 & qAge = 1;
  qGreenLast := qPhase = 1 & qAge = 2;
  qAmber := qPhase = 2;
  oneColor := (Red & !Green & !Amber) | (!Red & Green & !Amber) | (!Red & !Green & Amber);

INVARSPEC NAME P1 := oneColor;
LTLSPEC NAME P2 := G(!Enable -> (Red & !Green & !Amber));
LTLSPEC NAME P3 := G((Enable & !Tick) -> (Phase = qPhase));
LTLSPEC NAME P4 := G((Enable & Tick & qRedLast) -> Green);
LTLSPEC NAME P5 := G((Enable & Tick & qGreenLast) -> Amber);
LTLSPEC NAME P6 := G((Enable & Tick & qAmber) -> Red);
LTLSPEC NAME P7 := (G(Enable) & G(F(Tick))) -> (G(F(Red)) & G(F(Green)) & G(F(Amber)));
LTLSPEC NAME V2_green_duration_3 := G((Enable & Tick & qPhase = 1 & qAge < 2) -> (Green & X(qPhase = 1)));
