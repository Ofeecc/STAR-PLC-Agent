-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB014 negative mutant: forgets the per-octet <= 255 upper bound check,
-- accepting invalid segment values >= 256 and violating P2.
MODULE main
VAR
  c0 : integer; c1 : integer; c2 : integer; c3 : integer;
  c4 : integer; c5 : integer; c6 : integer; c7 : integer;
  c8 : integer; c9 : integer;

INVAR
  c0 >= 0 & c0 <= 255 & c1 >= 0 & c1 <= 255 & c2 >= 0 & c2 <= 255 & c3 >= 0 & c3 <= 255 &
  c4 >= 0 & c4 <= 255 & c5 >= 0 & c5 <= 255 & c6 >= 0 & c6 <= 255 & c7 >= 0 & c7 <= 255 &
  c8 >= 0 & c8 <= 255 & c9 >= 0 & c9 <= 255;

DEFINE
  -- Simplified 4-segment shape prefix ("DDD.D.D.D\0") focusing on first octet > 255 bug.
  d0 := c0 >= 48 & c0 <= 57; d1 := c1 >= 48 & c1 <= 57; d2 := c2 >= 48 & c2 <= 57;
  dot3 := c3 = 46; d4 := c4 >= 48 & c4 <= 57; dot5 := c5 = 46; d6 := c6 >= 48 & c6 <= 57; dot7 := c7 = 46; d8 := c8 >= 48 & c8 <= 57; nul9 := c9 = 0;
  o0 := ((c0 - 48) * 100) + ((c1 - 48) * 10) + (c2 - 48);
  o1 := c4 - 48; o2 := c6 - 48; o3 := c8 - 48;
  shape_ok := d0 & d1 & d2 & dot3 & d4 & dot5 & d6 & dot7 & d8 & nul9;
  valid := shape_ok & o0 <= 255;
  packed := o0 * 16777216 + o1 * 65536 + o2 * 256 + o3;
  -- BUG: allows shape_ok without checking o0 <= 255 (e.g. "256.0.0.1").
  ipValue := shape_ok ? packed : 0;

INVARSPEC NAME P1 := valid -> ipValue = packed;
INVARSPEC NAME P2 := !valid -> ipValue = 0;
