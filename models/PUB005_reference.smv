-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB005 (Weld Gap Alarm and Startup Inhibition), nuXmv infinite-state SMT model.
-- Abstraction note: clock and DebounceTime_ms use exact integers in ms (5s = 5000 ms). P5 models TimeTick as dt_ms >= 5000 & dt_ms >= DebounceTime_ms.
MODULE main
FROZENVAR
  DebounceTime_ms : integer;
VAR
  Gap_Exceeded : boolean;
  Weld_E_Stop_NC : boolean;
  dt_ms : integer;
  first_scan : boolean;
  clk : integer;
  have_since : boolean;
  since : integer;

INIT DebounceTime_ms > 0 & first_scan & clk = 0 & !have_since & since = 0;
INVAR dt_ms >= 0 & clk >= 0;

ASSIGN
  next(first_scan) := FALSE;
  next(clk) := clk_now;
  next(have_since) := gapPermit;
  next(since) := since_now;

DEFINE
  clk_now := first_scan ? 0 : clk + dt_ms;
  startup := clk_now < 5000;
  gapPermit := !startup & Gap_Exceeded & Weld_E_Stop_NC;
  since_now := gapPermit ? (have_since ? since : clk_now) : 0;
  gapQualified := gapPermit & (have_since ? (clk_now - since >= DebounceTime_ms) : FALSE);
  Operator_Alert := gapPermit & gapQualified;
  Weld_Soft_Start_Active := startup;
  coarse_tick := dt_ms >= 5000 & dt_ms >= DebounceTime_ms;

INVARSPEC NAME P1 := Weld_Soft_Start_Active <-> startup;
INVARSPEC NAME P2 := (startup | !Weld_E_Stop_NC | !Gap_Exceeded) -> !Operator_Alert;
INVARSPEC NAME P3 := Operator_Alert <-> (!startup & Weld_E_Stop_NC & Gap_Exceeded & gapQualified);
LTLSPEC NAME P4 := G ((startup | !Weld_E_Stop_NC | !Gap_Exceeded) -> X (!gapQualified));
LTLSPEC NAME SPEC_clock_monotonic := G (!first_scan -> next(clk) >= clk);
LTLSPEC NAME P5 := G (F (coarse_tick)) -> G (G (Weld_E_Stop_NC & Gap_Exceeded) -> F (Operator_Alert));
