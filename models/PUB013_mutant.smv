-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB013 negative mutant: ignores night-mode occupancy exclusion in fan permit and swaps eco setpoint, violating P1 and P4.
MODULE main
VAR
  OCCUPANCY_DETECTED : boolean;
  ENERGY_SAVING_MODE : boolean;
  HVAC_MODE_SELECTOR : 0..3;
  dt_ms : integer;
  first_scan : boolean;
  clk : integer;
  have_since : boolean;
  since : integer;

INIT first_scan & clk = 0 & !have_since & since = 0;
INVAR dt_ms >= 0 & clk >= 0;

ASSIGN
  next(first_scan) := FALSE;
  next(clk) := clk_now;
  next(have_since) := OCC_PERMIT;
  next(since) := OCC_PERMIT ? (have_since ? since : clk_now) : 0;

DEFINE
  clk_now := first_scan ? 0 : clk + dt_ms;
  occupied := OCCUPANCY_DETECTED;
  night := HVAC_MODE_SELECTOR = 3;
  permit := occupied & !night;
  OCC_PERMIT := occupied;
  mature := OCC_PERMIT & (have_since ? (clk_now - since >= 30000) : FALSE);
  SUPPLY_FAN_RUN := OCC_PERMIT & mature;
  TEMP_SETPOINT_ADJUST := case
    HVAC_MODE_SELECTOR = 3 : 4;
    OCCUPANCY_DETECTED : 0;
    HVAC_MODE_SELECTOR = 0 : (ENERGY_SAVING_MODE ? 2 : 3);
    HVAC_MODE_SELECTOR = 1 : 1;
    TRUE : 4;
  esac;

INVARSPEC NAME P1 := SUPPLY_FAN_RUN -> permit;
INVARSPEC NAME P4 := (!night & !occupied & HVAC_MODE_SELECTOR = 0) -> (ENERGY_SAVING_MODE ? TEMP_SETPOINT_ADJUST = 3 : TEMP_SETPOINT_ADJUST = 2);
