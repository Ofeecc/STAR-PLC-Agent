-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB002 (Dual-Word Edge Detection), nuXmv finite-state SMT/AIGER model using exact 32-bit unsigned words.
-- Interface note: ST input "value" is renamed to "val" in SMV because "value" is an SMV reserved keyword.
MODULE main
VAR
  val : unsigned word[32];
  prev : unsigned word[32];

ASSIGN
  init(prev) := 0ud32_0;
  next(prev) := val;

DEFINE
  risingBits := val & !prev;
  fallingBits := prev & !val;
  hasChanged := val != prev;
  hasRisingEdges := risingBits != 0ud32_0;
  hasFallingEdges := fallingBits != 0ud32_0;
  pop_rising :=
    toint(risingBits[0:0]) + toint(risingBits[1:1]) + toint(risingBits[2:2]) + toint(risingBits[3:3]) +
    toint(risingBits[4:4]) + toint(risingBits[5:5]) + toint(risingBits[6:6]) + toint(risingBits[7:7]) +
    toint(risingBits[8:8]) + toint(risingBits[9:9]) + toint(risingBits[10:10]) + toint(risingBits[11:11]) +
    toint(risingBits[12:12]) + toint(risingBits[13:13]) + toint(risingBits[14:14]) + toint(risingBits[15:15]) +
    toint(risingBits[16:16]) + toint(risingBits[17:17]) + toint(risingBits[18:18]) + toint(risingBits[19:19]) +
    toint(risingBits[20:20]) + toint(risingBits[21:21]) + toint(risingBits[22:22]) + toint(risingBits[23:23]) +
    toint(risingBits[24:24]) + toint(risingBits[25:25]) + toint(risingBits[26:26]) + toint(risingBits[27:27]) +
    toint(risingBits[28:28]) + toint(risingBits[29:29]) + toint(risingBits[30:30]) + toint(risingBits[31:31]);
  pop_falling :=
    toint(fallingBits[0:0]) + toint(fallingBits[1:1]) + toint(fallingBits[2:2]) + toint(fallingBits[3:3]) +
    toint(fallingBits[4:4]) + toint(fallingBits[5:5]) + toint(fallingBits[6:6]) + toint(fallingBits[7:7]) +
    toint(fallingBits[8:8]) + toint(fallingBits[9:9]) + toint(fallingBits[10:10]) + toint(fallingBits[11:11]) +
    toint(fallingBits[12:12]) + toint(fallingBits[13:13]) + toint(fallingBits[14:14]) + toint(fallingBits[15:15]) +
    toint(fallingBits[16:16]) + toint(fallingBits[17:17]) + toint(fallingBits[18:18]) + toint(fallingBits[19:19]) +
    toint(fallingBits[20:20]) + toint(fallingBits[21:21]) + toint(fallingBits[22:22]) + toint(fallingBits[23:23]) +
    toint(fallingBits[24:24]) + toint(fallingBits[25:25]) + toint(fallingBits[26:26]) + toint(fallingBits[27:27]) +
    toint(fallingBits[28:28]) + toint(fallingBits[29:29]) + toint(fallingBits[30:30]) + toint(fallingBits[31:31]);
  noOfRisingBits := pop_rising;
  noOfFallingBits := pop_falling;

INVARSPEC NAME P1 := risingBits = (val & !prev);
INVARSPEC NAME P2 := fallingBits = (prev & !val);
INVARSPEC NAME P3 := (risingBits & fallingBits) = 0ud32_0;
INVARSPEC NAME P4 := (noOfRisingBits = pop_rising) & (noOfFallingBits = pop_falling) & noOfRisingBits >= 0 & noOfRisingBits <= 32 & noOfFallingBits >= 0 & noOfFallingBits <= 32;
INVARSPEC NAME P5 := (hasRisingEdges <-> risingBits != 0ud32_0) & (hasFallingEdges <-> fallingBits != 0ud32_0) & (hasChanged <-> val != prev);
INVARSPEC NAME V2_flags := (!hasChanged -> (!hasRisingEdges & !hasFallingEdges)) & ((hasRisingEdges | hasFallingEdges) -> hasChanged);
LTLSPEC NAME V2_init := prev = 0ud32_0;
LTLSPEC NAME P6 := G (val = next(prev));
