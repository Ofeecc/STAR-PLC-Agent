-- Negative control mutant for SELF001: omits seal-in qRun when Start is released.
MODULE main
VAR
  Start : boolean;
  Stop : boolean;
  GuardClosed : boolean;
  first : boolean;
  qRun : boolean;

ASSIGN
  init(first) := TRUE;
  next(first) := FALSE;
  init(qRun) := FALSE;
  next(qRun) := Run;

DEFINE
  Run := GuardClosed & !Stop & Start;

LTLSPEC NAME P1 := G(first -> !qRun);
LTLSPEC NAME P2 := G((Stop | !GuardClosed) -> !Run);
LTLSPEC NAME P3 := G((Start & !Stop & GuardClosed) -> Run);
LTLSPEC NAME P4 := G((!Start & !Stop & GuardClosed) -> (Run <-> qRun));
