-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB007 (Multi-Pump Switching Control System).
-- Exact integer priorities (-32768..32767), lower index wins ties, stop > start,
-- read-only priority/selection preservation.
MODULE main
VAR
  mode : boolean;
  start : boolean;
  stop : boolean;
  p1_pri : integer; p2_pri : integer; p3_pri : integer; p4_pri : integer; p5_pri : integer;
  p1_sel : boolean; p2_sel : boolean; p3_sel : boolean; p4_sel : boolean; p5_sel : boolean;
  run1 : boolean; run2 : boolean; run3 : boolean; run4 : boolean; run5 : boolean;

INVAR
  p1_pri >= -32768 & p1_pri <= 32767 &
  p2_pri >= -32768 & p2_pri <= 32767 &
  p3_pri >= -32768 & p3_pri <= 32767 &
  p4_pri >= -32768 & p4_pri <= 32767 &
  p5_pri >= -32768 & p5_pri <= 32767;

INIT !run1 & !run2 & !run3 & !run4 & !run5;

DEFINE
  -- Pump j beats pump i iff j has strictly higher priority, or equal priority and smaller 1-based index j < i.
  b21 := p2_pri > p1_pri;
  b31 := p3_pri > p1_pri;
  b41 := p4_pri > p1_pri;
  b51 := p5_pri > p1_pri;

  b12 := p1_pri >= p2_pri;
  b32 := p3_pri > p2_pri;
  b42 := p4_pri > p2_pri;
  b52 := p5_pri > p2_pri;

  b13 := p1_pri >= p3_pri;
  b23 := p2_pri >= p3_pri;
  b43 := p4_pri > p3_pri;
  b53 := p5_pri > p3_pri;

  b14 := p1_pri >= p4_pri;
  b24 := p2_pri >= p4_pri;
  b34 := p3_pri >= p4_pri;
  b54 := p5_pri > p4_pri;

  b15 := p1_pri >= p5_pri;
  b25 := p2_pri >= p5_pri;
  b35 := p3_pri >= p5_pri;
  b45 := p4_pri >= p5_pri;

  top3_1 := ((b21 ? 1 : 0) + (b31 ? 1 : 0) + (b41 ? 1 : 0) + (b51 ? 1 : 0)) <= 2;
  top3_2 := ((b12 ? 1 : 0) + (b32 ? 1 : 0) + (b42 ? 1 : 0) + (b52 ? 1 : 0)) <= 2;
  top3_3 := ((b13 ? 1 : 0) + (b23 ? 1 : 0) + (b43 ? 1 : 0) + (b53 ? 1 : 0)) <= 2;
  top3_4 := ((b14 ? 1 : 0) + (b24 ? 1 : 0) + (b34 ? 1 : 0) + (b54 ? 1 : 0)) <= 2;
  top3_5 := ((b15 ? 1 : 0) + (b25 ? 1 : 0) + (b35 ? 1 : 0) + (b45 ? 1 : 0)) <= 2;

  post_run1 := stop ? FALSE : (start ? (mode ? top3_1 : p1_sel) : run1);
  post_run2 := stop ? FALSE : (start ? (mode ? top3_2 : p2_sel) : run2);
  post_run3 := stop ? FALSE : (start ? (mode ? top3_3 : p3_sel) : run3);
  post_run4 := stop ? FALSE : (start ? (mode ? top3_4 : p4_sel) : run4);
  post_run5 := stop ? FALSE : (start ? (mode ? top3_5 : p5_sel) : run5);

  out_p1_pri := p1_pri; out_p2_pri := p2_pri; out_p3_pri := p3_pri; out_p4_pri := p4_pri; out_p5_pri := p5_pri;
  out_p1_sel := p1_sel; out_p2_sel := p2_sel; out_p3_sel := p3_sel; out_p4_sel := p4_sel; out_p5_sel := p5_sel;

ASSIGN
  next(run1) := post_run1;
  next(run2) := post_run2;
  next(run3) := post_run3;
  next(run4) := post_run4;
  next(run5) := post_run5;

INVARSPEC NAME P1 := stop -> (!post_run1 & !post_run2 & !post_run3 & !post_run4 & !post_run5);
INVARSPEC NAME P2 := (!stop & start & !mode) ->
                     (post_run1 = p1_sel & post_run2 = p2_sel & post_run3 = p3_sel & post_run4 = p4_sel & post_run5 = p5_sel);
INVARSPEC NAME P3 := (!stop & start & mode) ->
                     ((post_run1 <-> top3_1) & (post_run2 <-> top3_2) & (post_run3 <-> top3_3) &
                      (post_run4 <-> top3_4) & (post_run5 <-> top3_5) &
                      (((post_run1 ? 1 : 0) + (post_run2 ? 1 : 0) + (post_run3 ? 1 : 0) +
                        (post_run4 ? 1 : 0) + (post_run5 ? 1 : 0)) = 3));
INVARSPEC NAME P4 := (!stop & !start) ->
                     (post_run1 = run1 & post_run2 = run2 & post_run3 = run3 & post_run4 = run4 & post_run5 = run5);
INVARSPEC NAME P5 := (out_p1_pri = p1_pri & out_p2_pri = p2_pri & out_p3_pri = p3_pri & out_p4_pri = p4_pri & out_p5_pri = p5_pri) &
                     (out_p1_sel = p1_sel & out_p2_sel = p2_sel & out_p3_sel = p3_sel & out_p4_sel = p4_sel & out_p5_sel = p5_sel);
