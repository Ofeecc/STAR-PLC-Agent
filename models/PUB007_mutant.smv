-- Scope: EXPLICIT_SMV_MODEL_ONLY (not candidate ST verification).
-- Task: PUB007 negative mutant: breaks equal-priority ties by higher array index first instead of lower index,
-- violating P3 (TopThree lower-index tie-break).
MODULE main
VAR
  mode : boolean;
  start : boolean;
  stop : boolean;
  p1_pri : integer; p2_pri : integer; p3_pri : integer; p4_pri : integer; p5_pri : integer;
  p1_sel : boolean; p2_sel : boolean; p3_sel : boolean; p4_sel : boolean; p5_sel : boolean;
  run1 : boolean; run2 : boolean; run3 : boolean; run4 : boolean; run5 : boolean;

INVAR
  p1_pri >= -32768 & p1_pri <= 32767 &
  p2_pri >= -32768 & p2_pri <= 32767 &
  p3_pri >= -32768 & p3_pri <= 32767 &
  p4_pri >= -32768 & p4_pri <= 32767 &
  p5_pri >= -32768 & p5_pri <= 32767;

INIT !run1 & !run2 & !run3 & !run4 & !run5;

DEFINE
  b21 := p2_pri > p1_pri; b31 := p3_pri > p1_pri; b41 := p4_pri > p1_pri; b51 := p5_pri > p1_pri;
  b12 := p1_pri >= p2_pri; b32 := p3_pri > p2_pri; b42 := p4_pri > p2_pri; b52 := p5_pri > p2_pri;
  b13 := p1_pri >= p3_pri; b23 := p2_pri >= p3_pri; b43 := p4_pri > p3_pri; b53 := p5_pri > p3_pri;
  b14 := p1_pri >= p4_pri; b24 := p2_pri >= p4_pri; b34 := p3_pri >= p4_pri; b54 := p5_pri > p4_pri;
  b15 := p1_pri >= p5_pri; b25 := p2_pri >= p5_pri; b35 := p3_pri >= p5_pri; b45 := p4_pri >= p5_pri;

  top3_1 := ((b21 ? 1 : 0) + (b31 ? 1 : 0) + (b41 ? 1 : 0) + (b51 ? 1 : 0)) <= 2;
  top3_2 := ((b12 ? 1 : 0) + (b32 ? 1 : 0) + (b42 ? 1 : 0) + (b52 ? 1 : 0)) <= 2;
  top3_3 := ((b13 ? 1 : 0) + (b23 ? 1 : 0) + (b43 ? 1 : 0) + (b53 ? 1 : 0)) <= 2;
  top3_4 := ((b14 ? 1 : 0) + (b24 ? 1 : 0) + (b34 ? 1 : 0) + (b54 ? 1 : 0)) <= 2;
  top3_5 := ((b15 ? 1 : 0) + (b25 ? 1 : 0) + (b35 ? 1 : 0) + (b45 ? 1 : 0)) <= 2;

  -- BUG: reversed tie-break (>= on higher indices instead of lower indices).
  m_top3_1 := (((p2_pri >= p1_pri) ? 1 : 0) + ((p3_pri >= p1_pri) ? 1 : 0) + ((p4_pri >= p1_pri) ? 1 : 0) + ((p5_pri >= p1_pri) ? 1 : 0)) <= 2;
  m_top3_2 := (((p1_pri > p2_pri) ? 1 : 0) + ((p3_pri >= p2_pri) ? 1 : 0) + ((p4_pri >= p2_pri) ? 1 : 0) + ((p5_pri >= p2_pri) ? 1 : 0)) <= 2;
  m_top3_3 := (((p1_pri > p3_pri) ? 1 : 0) + ((p2_pri > p3_pri) ? 1 : 0) + ((p4_pri >= p3_pri) ? 1 : 0) + ((p5_pri >= p3_pri) ? 1 : 0)) <= 2;
  m_top3_4 := (((p1_pri > p4_pri) ? 1 : 0) + ((p2_pri > p4_pri) ? 1 : 0) + ((p3_pri > p4_pri) ? 1 : 0) + ((p5_pri >= p4_pri) ? 1 : 0)) <= 2;
  m_top3_5 := (((p1_pri > p5_pri) ? 1 : 0) + ((p2_pri > p5_pri) ? 1 : 0) + ((p3_pri > p5_pri) ? 1 : 0) + ((p4_pri > p5_pri) ? 1 : 0)) <= 2;

  post_run1 := stop ? FALSE : (start ? (mode ? m_top3_1 : p1_sel) : run1);
  post_run2 := stop ? FALSE : (start ? (mode ? m_top3_2 : p2_sel) : run2);
  post_run3 := stop ? FALSE : (start ? (mode ? m_top3_3 : p3_sel) : run3);
  post_run4 := stop ? FALSE : (start ? (mode ? m_top3_4 : p4_sel) : run4);
  post_run5 := stop ? FALSE : (start ? (mode ? m_top3_5 : p5_sel) : run5);

ASSIGN
  next(run1) := post_run1;
  next(run2) := post_run2;
  next(run3) := post_run3;
  next(run4) := post_run4;
  next(run5) := post_run5;

INVARSPEC NAME P1 := stop -> (!post_run1 & !post_run2 & !post_run3 & !post_run4 & !post_run5);
INVARSPEC NAME P3 := (!stop & start & mode) ->
                     ((post_run1 <-> top3_1) & (post_run2 <-> top3_2) & (post_run3 <-> top3_3) &
                      (post_run4 <-> top3_4) & (post_run5 <-> top3_5));
