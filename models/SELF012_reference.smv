MODULE main
VAR
  Start : boolean;
  Stop : boolean;
  Fault : boolean;
  Reset : boolean;
  first : boolean;
  mode : {IDLE, RUNNING, WAIT, LOCKED};
  qAttempts : 0..2;
  qFree : 0..2;

ASSIGN
  init(first) := TRUE;
  next(first) := FALSE;
  init(mode) := IDLE;
  next(mode) := nextMode;
  init(qAttempts) := 0;
  next(qAttempts) := Attempts;
  init(qFree) := 0;
  next(qFree) := nextFree;

DEFINE
  validReset := Reset & !Fault & !Start;
  normal := !validReset & !Stop;
  qLocked := mode = LOCKED;
  qRunning := mode = RUNNING;
  qWait := mode = WAIT;
  retryDue := qWait & !Fault & qFree >= 1;

  nextMode := case
    validReset : IDLE;
    qLocked : LOCKED;
    Stop : IDLE;
    mode = IDLE & Start & !Fault : RUNNING;
    qRunning & Fault & qAttempts < 2 : WAIT;
    qRunning & Fault : LOCKED;
    qWait & !Fault & qFree >= 1 : RUNNING;
    TRUE : mode;
  esac;

  Attempts := case
    validReset : 0;
    qLocked | Stop : qAttempts;
    retryDue : (qAttempts < 2 ? qAttempts + 1 : 2);
    TRUE : qAttempts;
  esac;

  nextFree := case
    validReset : 0;
    qLocked : qFree;
    Stop : 0;
    qRunning & Fault : 0;
    qWait & Fault : 0;
    retryDue : 0;
    qWait & !Fault & qFree = 0 : 1;
    TRUE : qFree;
  esac;

  Run := nextMode = RUNNING;
  Locked := nextMode = LOCKED;

LTLSPEC NAME P1 := G(Fault -> !Run);
INVARSPEC NAME P2 := Attempts >= 0 & Attempts <= 2;
LTLSPEC NAME P3 := G(validReset -> (!Run & !Locked & Attempts = 0));
LTLSPEC NAME P4 := G((qLocked & !validReset) -> (Locked & !Run));
LTLSPEC NAME P5 := G((qRunning & Fault & normal & qAttempts = 2) -> Locked);
LTLSPEC NAME P6 := G((retryDue & normal) -> (Run & Attempts = qAttempts + 1));
LTLSPEC NAME P7 := G((qWait & Fault & normal) -> !Run);

-- V2 completeness additions: init, start from IDLE, RUNNING hold, enter WAIT, 2-scan dwell, Stop keeps Attempts, Attempts hold
LTLSPEC NAME V2_init := first -> (mode = IDLE & qAttempts = 0 & qFree = 0);
LTLSPEC NAME V2_start_from_idle := G((normal & mode = IDLE & Start & !Fault) -> (Run & !Locked & X(qRunning)));
LTLSPEC NAME V2_running_hold := G((normal & qRunning & !Fault) -> (Run & !Locked & X(qRunning)));
LTLSPEC NAME V2_enter_wait := G((normal & qRunning & Fault & qAttempts < 2) -> (!Run & !Locked & X(qWait & qFree = 0)));
LTLSPEC NAME V2_wait_first_healthy_off := G((normal & qWait & !Fault & qFree = 0) -> (!Run & !Locked & Attempts = qAttempts & X(qWait & qFree = 1)));
LTLSPEC NAME V2_stop_resets_keeps_attempts := G((!validReset & !qLocked & Stop) -> (!Run & !Locked & Attempts = qAttempts & X(mode = IDLE & qFree = 0)));
LTLSPEC NAME V2_attempts_hold := G((!validReset & !retryDue) -> (Attempts = qAttempts));
