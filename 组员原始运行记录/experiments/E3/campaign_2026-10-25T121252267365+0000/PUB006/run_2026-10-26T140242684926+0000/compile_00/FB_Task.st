FUNCTION_BLOCK FB_Task
VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR
VAR_OUTPUT
    BLOWER_RUN : BOOL := FALSE;
    AERATION_BLOWER_CYCLE_COUNT : UINT := 0;
END_VAR
VAR
    StartDelayTimer : TON;
    Permit : BOOL;
END_VAR

Permit := DO_LOW AND AERATION_E_STOP_NC;

StartDelayTimer(IN := Permit, PT := T#5S);

IF Permit AND StartDelayTimer.Q THEN
    IF NOT BLOWER_RUN THEN
        AERATION_BLOWER_CYCLE_COUNT := AERATION_BLOWER_CYCLE_COUNT + UINT#1;
    END_IF
    BLOWER_RUN := TRUE;
ELSE
    BLOWER_RUN := FALSE;
END_IF
END_FUNCTION_BLOCK
