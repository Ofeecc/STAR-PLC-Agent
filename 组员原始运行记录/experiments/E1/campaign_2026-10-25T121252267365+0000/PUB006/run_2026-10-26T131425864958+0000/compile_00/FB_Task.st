FUNCTION_BLOCK FB_Task
VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR
VAR_OUTPUT
    BLOWER_RUN : BOOL;
    AERATION_BLOWER_CYCLE_COUNT : UINT;
END_VAR
VAR
    tonStartDelay : TON;
    bPermit : BOOL;
    bRunPrev : BOOL;
END_VAR

bPermit := DO_LOW AND AERATION_E_STOP_NC;

tonStartDelay(IN := bPermit, PT := T#5S);

IF bPermit AND tonStartDelay.Q THEN
    BLOWER_RUN := TRUE;
ELSE
    BLOWER_RUN := FALSE;
END_IF

IF BLOWER_RUN AND NOT bRunPrev THEN
    AERATION_BLOWER_CYCLE_COUNT := AERATION_BLOWER_CYCLE_COUNT + 1;
END_IF

bRunPrev := BLOWER_RUN;
END_FUNCTION_BLOCK
