FUNCTION_BLOCK FB_Task
VAR_INPUT
    OCCUPANCY_DETECTED : BOOL;
    ENERGY_SAVING_MODE : BOOL;
    HVAC_MODE_SELECTOR : INT;
END_VAR
VAR_OUTPUT
    SUPPLY_FAN_RUN : BOOL := FALSE;
    TEMP_SETPOINT_ADJUST : INT := 0;
END_VAR
VAR
    tmrFanStart : TON;
    xInitialized : BOOL := FALSE;
    xPermit : BOOL;
END_VAR

IF NOT xInitialized THEN
    SUPPLY_FAN_RUN := FALSE;
    TEMP_SETPOINT_ADJUST := 0;
    xInitialized := TRUE;
END_IF;

xPermit := OCCUPANCY_DETECTED AND (HVAC_MODE_SELECTOR <> 3);

tmrFanStart(IN := xPermit, PT := T#30S);
SUPPLY_FAN_RUN := xPermit AND tmrFanStart.Q;

CASE HVAC_MODE_SELECTOR OF
    0:
        IF OCCUPANCY_DETECTED THEN
            TEMP_SETPOINT_ADJUST := 0;
        ELSIF ENERGY_SAVING_MODE THEN
            TEMP_SETPOINT_ADJUST := 3;
        ELSE
            TEMP_SETPOINT_ADJUST := 2;
        END_IF;
    1:
        IF OCCUPANCY_DETECTED THEN
            TEMP_SETPOINT_ADJUST := 0;
        ELSE
            TEMP_SETPOINT_ADJUST := 1;
        END_IF;
    2:
        IF OCCUPANCY_DETECTED THEN
            TEMP_SETPOINT_ADJUST := 0;
        ELSE
            TEMP_SETPOINT_ADJUST := 4;
        END_IF;
    3:
        TEMP_SETPOINT_ADJUST := 4;
    ELSE
        TEMP_SETPOINT_ADJUST := 0;
END_CASE;

TEMP_SETPOINT_ADJUST := LIMIT(-4, TEMP_SETPOINT_ADJUST, 4);
END_FUNCTION_BLOCK
