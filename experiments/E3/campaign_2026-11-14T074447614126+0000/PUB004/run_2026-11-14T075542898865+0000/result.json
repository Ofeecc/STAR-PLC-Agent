    "declaration": "FUNCTION_BLOCK FB_Task\nVAR_INPUT\n    VISCOSITY_OK : BOOL;\n    PASTE_E_STOP_NC : BOOL;\n    DebounceTime : TIME;\n    CycleTime : TIME;\nEND_VAR\nVAR_OUTPUT\n    VFD_RUN : BOOL := FALSE;\n    PUMP_MAINT_DUE : BOOL := FALSE;\n    PUMP_RUNTIME_ACC : LTIME := LTIME#0ns;\nEND_VAR\nVAR\n    DebounceTimer : TON;\n    permit : BOOL := FALSE;\n    qualified : BOOL := FALSE;\n    immediateSafetyReset : BOOL := FALSE;\n    initialized : BOOL := FALSE;\nEND_VAR\nVAR CONSTANT\n    MAINT_LIMIT : LTIME := LTIME#500h;\nEND_VAR",
