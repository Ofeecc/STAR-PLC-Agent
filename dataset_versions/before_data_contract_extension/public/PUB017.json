  "scan_semantics": "Inputs I[k] are sampled at invocation; outputs O[k] are observed after the call. Retained pre-state q[k] becomes q[k+1]. Each test resets the instance. A transition affects the same observed scan. dt_ms is elapsed time since the preceding invocation; the first invocation starts IEC timers at elapsed zero. CycleTime inputs, where supplied, are attributed to the current invocation rather than inferred from dt_ms.",
  "safety_priority": [
    "Duplicate checking precedes database-full checking.",
    "Failed requests must not mutate the database.",
    "Insertion uses the lowest-index empty slot."
  ],
  "assumptions": [
    "At most one request rises per call. Requests use rising edges; simultaneous request priority is unspecified by the source.",
    "Only positive nonzero IDs are submitted; zero denotes an unused slot.",
    "Success indicators are one-invocation pulses. error/status clear on idle.",
    "recipeQueryResult retains the last successful query until another successful query.",
    "Deleting a record clears only its recipeID; its other fields become unconstrained.",
    "The caller-owned recipe array is initialized once and persists across steps; do not overwrite it with initial values per scan.",
    "Compare REAL values with absolute tolerance 1e-5.",
    "The specification_contract is normative and supplied identically to both frameworks. Output names always denote observed candidate outputs, never precomputed expected values.",
    "Floating-point inputs and intermediate reference arithmetic are finite. Existing fixed traces retain their declared absolute tolerance; claims do not extend to arbitrary magnitudes without a separately specified numeric error policy."
  ],
  "atomic_propositions": {
    "q_missing": "rising(queryRecipe) AND ID absent from pre-database",
    "a_dup": "rising(addRecipe) AND ID exists",
    "a_full": "rising(addRecipe) AND ID absent AND all slots full",
    "d_missing": "rising(deleteRecipe) AND ID absent",
    "m_missing": "rising(modifyRecipe) AND ID absent",
    "e1": "error AND status=16#8001",
    "e2": "error AND status=16#8002",
    "e3": "error AND status=16#8003",
    "e4": "error AND status=16#8004",
    "e5": "error AND status=16#8005",
    "error": "error output",
    "same": "database equals pre-database",
    "add_ok": "rising(addRecipe) AND positive ID absent AND empty slot exists",
    "insert": "lowest-index pre-empty slot equals recipeIn; all other slots unchanged",
    "add_success": "recipeAdded AND NOT error AND status=0",
    "query_ok": "rising(queryRecipe) AND matching record exists",
    "result": "recipeQueryResult equals matching pre-record",
    "idle": "no rising request",
    "clear": "NOT error AND status=0 AND NOT recipeAdded AND NOT recipeDeleted AND NOT recipeModified",
    "unique": "all nonzero IDs are pairwise distinct",
    "CompleteBehaviorV2": "逐操作定义dbAfter与dbBefore：新增替换最低空位；删除只将匹配记录ID置0，其余记录保持，删除槽非ID字段保持或不约束须声明；修改仅匹配槽整体替换；查询/空闲/失败数据库全保持。successAdded/Deleted/Modified分别与对应成功事件等价，每拍脉冲；所有成功/空闲error=FALSE,status=0。查询结果仅成功查询更新，其余保持。"
  },
  "ltl": [
    {
      "id": "PUB017.P1",
      "name": "Errors",
      "formula": "G((q_missing -> e1) & (a_dup -> e2) & (a_full -> e3) & (d_missing -> e4) & (m_missing -> e5))",
      "explanation": "Distinct failures produce the official status codes."
    },
    {
      "id": "PUB017.P2",
      "name": "No mutation",
      "formula": "G(error -> same)",
      "explanation": "Rejected operations preserve all records."
    },
    {
      "id": "PUB017.P3",
      "name": "Lowest insertion",
      "formula": "G(add_ok -> (insert & add_success))",
      "explanation": "Adds use the lowest free slot."
    },
    {
      "id": "PUB017.P4",
      "name": "Query",
      "formula": "G(query_ok -> result)",
      "explanation": "Query returns the complete matched record."
    },
    {
      "id": "PUB017.P5",
      "name": "Idle",
      "formula": "G(idle -> clear)",
      "explanation": "Indicators and invocation errors clear on idle."
    },
    {
      "id": "PUB017.P6",
      "name": "Uniqueness",
      "formula": "G(unique)",
      "explanation": "All operations preserve ID uniqueness from a valid initial database."
    },
    {
      "id": "PUB017.V2.COMPLETE",
      "formula": "G(CompleteBehaviorV2)",
      "explanation": "The complete per-invocation relation defined in specification_contract.normative_completion; requires explicit encoding before model checking."
    }
  ],
