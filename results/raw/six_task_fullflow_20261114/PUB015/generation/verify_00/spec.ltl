-- Formal verification specification for Task PUB015
-- Generated: 2026-11-14T08:43:03.799387+00:00

-- Property: PUB015.P_init
-- Description: Applies strictly to the fresh pre-invocation initial instance observation before scan k=0 (INITIAL_INSTANCE scope).
LTLSPEC NAME PUB015.P_init := init;

-- Property: PUB015.P1
-- Description: Emergency permissive dominates mode and buttons.
LTLSPEC NAME PUB015.P1 := G(!safe -> off);

-- Property: PUB015.P2
-- Description: A held button cannot repeatedly toggle; applies independently to all five buttons.
LTLSPEC NAME PUB015.P2 := G((toggle -> changed) & (held -> same));

-- Property: PUB015.P3
-- Description: A closes and B opens at or above 50cm.
LTLSPEC NAME PUB015.P3 := G(toB -> B);

-- Property: PUB015.P4
-- Description: The two-material branch skips C.
LTLSPEC NAME PUB015.P4 := G(toMix -> Mix);

-- Property: PUB015.P5
-- Description: C fills to 100cm before mixing.
LTLSPEC NAME PUB015.P5 := G((toC -> C) & (fromC -> Mix));

-- Property: PUB015.P6
-- Description: Mix completion stops mixing and opens D.
LTLSPEC NAME PUB015.P6 := G(mixed -> Drain);

-- Property: PUB015.P7
-- Description: Extends P2 manual coverage from valveA to all five actuators (A, B, C, D, Mix).
LTLSPEC NAME PUB015.P7 := G(manual_toggles);

-- Property: PUB015.P8
-- Description: Guarantees single-actuator automatic progression and mode-change isolation.
LTLSPEC NAME PUB015.P8 := G((safe & opeMode -> oneActuator) & (modeChanged -> off));
