  "candidate": {
    "declaration": "FUNCTION_BLOCK FB_Task\nVAR_INPUT\n    Fault : BOOL;\n    Ack : BOOL;\n    Reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    Alarm : BOOL := FALSE;\n    Acknowledged : BOOL := FALSE;\n    Horn : BOOL := FALSE;\nEND_VAR\nVAR\n    state : USINT := 0;\n    previous_fault : BOOL := FALSE;\n    fault_rise : BOOL := FALSE;\n    sampled_fault : BOOL;\n    sampled_ack : BOOL;\n    sampled_reset : BOOL;\nEND_VAR\nVAR CONSTANT\n    ST_IDLE : USINT := 0;\n    ST_UNACK : USINT := 1;\n    ST_ACKED : USINT := 2;\nEND_VAR",
    "implementation": "sampled_fault := Fault;\nsampled_ack := Ack;\nsampled_reset := Reset;\n\nfault_rise := sampled_fault AND NOT previous_fault;\nprevious_fault := sampled_fault;\n\nCASE state OF\n    ST_IDLE:\n        IF sampled_reset AND NOT sampled_fault THEN\n            state := ST_IDLE;\n        ELSIF fault_rise THEN\n            state := ST_UNACK;\n        ELSIF sampled_fault AND sampled_ack THEN\n            state := ST_ACKED;\n        ELSIF sampled_fault THEN\n            state := ST_UNACK;\n        END_IF;\n\n    ST_UNACK:\n        IF sampled_reset AND NOT sampled_fault THEN\n            state := ST_IDLE;\n        ELSIF fault_rise THEN\n            state := ST_UNACK;\n        ELSIF sampled_ack THEN\n            state := ST_ACKED;\n        END_IF;\n\n    ST_ACKED:\n        IF sampled_reset AND NOT sampled_fault THEN\n            state := ST_IDLE;\n        ELSIF fault_rise THEN\n            state := ST_UNACK;\n        END_IF;\n\n    ELSE\n        state := ST_IDLE;\nEND_CASE;\n\nAlarm := state <> ST_IDLE;\nAcknowledged := state = ST_ACKED;\nHorn := Alarm AND NOT Acknowledged;",
    "supporting_objects": []
  },
