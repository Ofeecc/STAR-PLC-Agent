          "text": "{\n  \"state_machine\": [\n    {\n      \"state\": \"BLOCKED\",\n      \"meaning\": \"Occupancy is absent or Night is selected; fan is off and the delay is reset.\",\n      \"transitions\": [\n        {\n          \"condition\": \"OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3\",\n          \"to\": \"PERMITTED\"\n        },\n        {\n          \"condition\": \"NOT OCCUPANCY_DETECTED OR HVAC_MODE_SELECTOR = 3\",\n          \"to\": \"BLOCKED\"\n        }\n      ]\n    },\n    {\n      \"state\": \"PERMITTED\",\n      \"meaning\": \"The fan is waiting while the timer Q is false and running while Q is true.\",\n      \"transitions\": [\n        {\n          \"condition\": \"NOT OCCUPANCY_DETECTED OR HVAC_MODE_SELECTOR = 3\",\n          \"to\": \"BLOCKED\"\n        },\n        {\n          \"condition\": \"OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3\",\n          \"to\": \"PERMITTED\"\n        }\n      ]\n    }\n  ],\n  \"timer_plan\": [\n    {\n      \"name\": \"FAN_START_DELAY\",\n      \"type\": \"IEC TON\",\n      \"PT\": \"T#30s\",\n      \"input\": \"OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3\",\n      \"reset_conditions\": \"Call with IN = FALSE on occupancy loss or selection of Night; initialize the instance reset at power-up.\",\n      \"timing\": \"The first permitted call starts at elapsed zero. Q becomes true on the first call at or after 30 seconds of continuously sampled permit. Switching among Auto, Comfort and Economy does not reset the timer.\"\n    }\n  ],\n  \"priorities\": [\n    \"Occupancy loss or Night stops the fan and resets the timer in the same observed scan.\",\n    \"Night temperature adjustment overrides occupancy and energy-saving selection.\",\n    \"Energy-saving selection affects only unoccupied Auto adjustment.\",\n    \"Temperature adjustment is independent of the fan delay and is bounded to -4 through +4 degrees Celsius.\"\n  ],\n  \"initial_values\": {\n    \"scope\": \"Fresh instance, before the first invocation\",\n    \"SUPPLY_FAN_RUN\": false,\n    \"TEMP_SETPOINT_ADJUST\": 0,\n    \"state\": \"BLOCKED\",\n    \"previous_permit\": false,\n    \"FAN_START_DELAY.Q\": false,\n    \"FAN_START_DELAY.ET\": \"T#0s\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"action\": \"Snapshot all inputs. Compute permit as OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3. Derive rising and falling permit edges from previous_permit, then update previous_permit. Edges are observational; timer control uses the permit level.\"\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"action\": \"If permit is false, select BLOCKED; otherwise select PERMITTED. This transition takes effect in the current scan. Do not use a previous-scan timer Q to decide the fan output.\"\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls outside CASE/IF\",\n      \"action\": \"Call FAN_START_DELAY exactly once with IN := permit and PT := T#30s. Its current-call Q and reset are available to stage 4.\"\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"action\": \"Assign SUPPLY_FAN_RUN := permit AND FAN_START_DELAY.Q. Calculate TEMP_SETPOINT_ADJUST from the sampled inputs: Night = 4; otherwise occupied = 0; otherwise Auto = 3 if energy saving is true or 2 if false, Comfort = 1, Economy = 4. Clamp the result to [-4, 4]. Calculate outputs on the first invocation as well.\"\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G(SUPPLY_FAN_RUN -> (OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3))\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G(TEMP_SETPOINT_ADJUST >= -4 AND TEMP_SETPOINT_ADJUST <= 4)\"\n    },\n    {\n      \"id\": \"A3\",\n      \"formula\": \"G((HVAC_MODE_SELECTOR = 3) -> (TEMP_SETPOINT_ADJUST = 4))\"\n    },\n    {\n      \"id\": \"A4\",\n      \"formula\": \"G((OCCUPANCY_DETECTED AND HVAC_MODE_SELECTOR <> 3) -> (TEMP_SETPOINT_ADJUST = 0))\"\n    },\n    {\n      \"id\": \"A5\",\n      \"formula\": \"G((HVAC_MODE_SELECTOR = 0 AND NOT OCCUPANCY_DETECTED AND ENERGY_SAVING_MODE) -> (TEMP_SETPOINT_ADJUST = 3))\"\n    },\n    {\n      \"id\": \"A6\",\n      \"formula\": \"G((HVAC_MODE_SELECTOR = 0 AND NOT OCCUPANCY_DETECTED AND NOT ENERGY_SAVING_MODE) -> (TEMP_SETPOINT_ADJUST = 2))\"\n    },\n    {\n      \"id\": \"A7\",\n      \"formula\": \"G((HVAC_MODE_SELECTOR = 1 AND NOT OCCUPANCY_DETECTED) -> (TEMP_SETPOINT_ADJUST = 1))\"\n    },\n    {\n      \"id\": \"A8\",\n      \"formula\": \"G((HVAC_MODE_SELECTOR = 2 AND NOT OCCUPANCY_DETECTED) -> (TEMP_SETPOINT_ADJUST = 4))\"\n    }\n  ]\n}",
