e,\n    \"candidate_a\": false,\n    \"candidate_b\": false,\n    \"note\": \"These are instance values before the first invocation. Inputs are externally supplied; scratch values are overwritten on each scan.\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"actions\": [\n        \"Sample Demand, FaultA and FaultB once into sampled_demand, sampled_fault_a and sampled_fault_b.\",\n        \"Compute falling_demand := previous_demand AND NOT sampled_demand using the retained pre-scan value.\"\n      ]\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"actions\": [\n        \"If falling_demand AND episode_served, set lead_pref := NOT lead_pref; otherwise retain lead_pref.\",\n        \"Compute candidate_a := sampled_demand AND NOT sampled_fault_a AND (lead_pref OR sampled_fault_b).\",\n        \"Compute candidate_b := sampled_demand AND NOT sampled_fault_b AND (NOT lead_pref OR sampled_fault_a).\",\n        \"If sampled_demand is FALSE, set episode_served := FALSE; otherwise set episode_served := episode_served OR candidate_a OR candidate_b.\",\n        \"Set previous_demand := sampled_demand. There is no external reset input; instance initialization supplies the reset values.\"\n      ]\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls outside CASE/IF\",\n      \"actions\": [\n        \"No timer FBs or timer calls are required.\"\n      ]\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"actions\": [\n        \"Assign PumpA := candidate_a, PumpB := candidate_b and LeadA := lead_pref exactly once.\",\n        \"Observe these post-transition outputs at the end of the same scan.\"\n      ]\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G(!(PumpA & PumpB))\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G(P