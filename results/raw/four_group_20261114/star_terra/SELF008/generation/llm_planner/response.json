          "text": "{\n  \"state_machine\": [\n    {\n      \"state\": \"RESET\",\n      \"definition\": \"Post-scan Count = 0 and Ready = FALSE; also the initial state.\"\n    },\n    {\n      \"state\": \"QUALIFYING\",\n      \"definition\": \"Post-scan Count > 0 and Ready = FALSE.\"\n    },\n    {\n      \"state\": \"READY\",\n      \"definition\": \"Post-scan Ready = TRUE.\"\n    },\n    {\n      \"transitions\": [\n        \"From any state, if Trip is TRUE, Request is FALSE, or Preset is outside 1..5, transition to RESET.\",\n        \"Otherwise, set next Count to min(previous Count + 1, sampled Preset). Transition to READY if next Count >= Preset; otherwise transition to QUALIFYING.\"\n      ],\n      \"note\": \"States are descriptive classifications, not separately retained variables. Preset changes do not independently reset progress: lowering it clamps Count; raising it may clear Ready.\"\n    }\n  ],\n  \"timer_plan\": {\n    \"timers_required\": [],\n    \"PT_durations\": \"None.\",\n    \"reset_conditions\": \"Not applicable; qualification counts scan invocations, not elapsed time.\"\n  },\n  \"priorities\": [\n    \"Trip, missing Request, or invalid Preset clears Count and Ready in the same scan, with priority over qualification.\",\n    \"On every other scan, increment and saturate Count, then derive Ready from the updated Count.\",\n    \"Trip is evaluated from the once-per-scan sample; no asynchronous between-scan response is implied.\"\n  ],\n  \"initial_values\": {\n    \"Count\": 0,\n    \"Ready\": false,\n    \"NextCount\": 0,\n    \"NextReady\": false,\n    \"notes\": \"Count is the retained prior-scan count. Initial values apply before the first invocation; the first scan executes normally.\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"actions\": \"Sample Request, Trip, and Preset once into local snapshots. No edge detectors are required; qualification is level-based.\"\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"actions\": \"Read retained Count before output assignment. If sampled Trip, missing Request, or invalid Preset is present, set NextCount := 0 and NextReady := FALSE. Otherwise set NextCount := min(INT(Count) + 1, INT(sampled Preset)), converted to USINT, and NextReady := (NextCount >= sampled Preset).\"\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls outside CASE/IF\",\n      \"actions\": \"No timer FBs are required or called.\"\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"actions\": \"Assign Count := NextCount and Ready := NextReady exactly once. These are the observed outputs for the current scan.\"\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G((Trip | !Request | (Preset < 1) | (Preset > 5)) -> (!Ready & (Count = 0)))\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G(Ready <-> ((Preset >= 1) & (Preset <= 5) & (Count >= Preset)))\"\n    },\n    {\n      \"id\": \"A3\",\n      \"formula\": \"G(((Preset >= 1) & (Preset <= 5)) -> (Count <= Preset))\"\n    },\n    {\n      \"id\": \"A4\",\n      \"formula\": \"G((Request & !Trip & (Preset >= 1) & (Preset <= 5)) -> (Count >= 1))\"\n    }\n  ]\n}",
