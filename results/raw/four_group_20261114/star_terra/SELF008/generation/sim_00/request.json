    "declaration": "FUNCTION_BLOCK FB_Task\nVAR_INPUT\n    Request : BOOL;\n    Trip : BOOL;\n    Preset : USINT;\nEND_VAR\nVAR_OUTPUT\n    Ready : BOOL := FALSE;\n    Count : USINT := 0;\nEND_VAR\nVAR\n    SampledRequest : BOOL;\n    SampledTrip : BOOL;\n    SampledPreset : USINT;\n    NextCount : USINT := 0;\n    NextReady : BOOL := FALSE;\nEND_VAR",
    "implementation": "SampledRequest := Request;\nSampledTrip := Trip;\nSampledPreset := Preset;\n\nIF SampledTrip OR NOT SampledRequest OR (SampledPreset < USINT#1) OR (SampledPreset > USINT#5) THEN\n    NextCount := 0;\n    NextReady := FALSE;\nELSE\n    IF Count >= SampledPreset THEN\n        NextCount := SampledPreset;\n    ELSE\n        NextCount := Count + USINT#1;\n    END_IF;\n    NextReady := (NextCount >= SampledPreset);\nEND_IF;\n\nCount := NextCount;\nReady := NextReady;",
    "supporting_objects": []
  },
