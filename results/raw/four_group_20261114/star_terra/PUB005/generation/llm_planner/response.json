          "logprobs": [],
          "text": "{\n  \"state_machine\": [\n    {\n      \"state\": \"E_STOP\",\n      \"initial\": true,\n      \"description\": \"Conservative initial state; after input sampling, indicates an active E-stop. Startup inhibition runs independently.\",\n      \"transitions\": [\n        {\n          \"condition\": \"Weld_E_Stop_NC = TRUE\",\n          \"target\": \"READY\"\n        },\n        {\n          \"condition\": \"Weld_E_Stop_NC = FALSE\",\n          \"target\": \"E_STOP\"\n        }\n      ]\n    },\n    {\n      \"state\": \"READY\",\n      \"description\": \"E-stop is inactive. Gap monitoring is permitted only after startup inhibition expires.\",\n      \"transitions\": [\n        {\n          \"condition\": \"Weld_E_Stop_NC = FALSE\",\n          \"target\": \"E_STOP\"\n        },\n        {\n          \"condition\": \"Weld_E_Stop_NC = TRUE\",\n          \"target\": \"READY\"\n        }\n      ]\n    }\n  ],\n  \"timer_plan\": [\n    {\n      \"name\": \"T_Startup\",\n      \"type\": \"TON\",\n      \"PT\": \"T#5s\",\n      \"input\": \"TRUE\",\n      \"reset_conditions\": \"Fresh instance or power-up reinitialization only; E-stop does not reset it.\",\n      \"semantics\": \"Starts with elapsed time zero on the first FB invocation. Q becomes TRUE at elapsed time >= 5 seconds and remains TRUE. Time advances monotonically through E-stop.\"\n    },\n    {\n      \"name\": \"T_Gap\",\n      \"type\": \"TON\",\n      \"PT\": \"DebounceTime\",\n      \"input\": \"T_Startup.Q AND Weld_E_Stop_NC AND Gap_Exceeded\",\n      \"reset_conditions\": \"Reset on any invocation where startup is active, E-stop is active, or Gap_Exceeded is FALSE.\",\n      \"semantics\": \"The first eligible sampled invocation has elapsed time zero, including the scan that completes startup. Q becomes TRUE after a continuous eligible interval of at least DebounceTime. DebounceTime is assumed positive and constant within a test.\"\n    }\n  ],\n  \"priorities\": [\n    \"E-stop immediately suppresses Operator_Alert and clears gap timing; it does not interrupt or restart startup timing.\",\n    \"Startup inhibition suppresses Operator_Alert and prevents gap timing. Weld_Soft_Start_Active reports startup independently of E-stop.\",\n    \"A FALSE gap input immediately suppresses the alert and clears gap timing.\",\n    \"Only a continuously qualified gap after startup with E-stop inactive permits the alert.\"\n  ],\n  \"initial_values\": {\n    \"Operator_Alert\": false,\n    \"Weld_Soft_Start_Active\": true,\n    \"state\": \"E_STOP\",\n    \"T_Startup.ET\": \"T#0ms\",\n    \"T_Startup.Q\": false,\n    \"T_Gap.ET\": \"T#0ms\",\n    \"T_Gap.Q\": false,\n    \"startupElapsed_ms\": 0,\n    \"gapElapsed_ms\": 0,\n    \"note\": \"Elapsed values are timer state, not separate accumulating counters. These values apply to a fresh instance before its first invocation.\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"actions\": \"Sample all inputs once. Timer enable transitions are determined from these sampled values; no unobserved input stability is assumed.\"\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"actions\": \"Set state to E_STOP when sampled Weld_E_Stop_NC is FALSE, otherwise READY. Establish gap suppression for active E-stop or FALSE gap; startup suppression is resolved using the current startup timer result in stage 3.\"\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls\",\n      \"actions\": \"Outside all CASE/IF branches, call T_Startup(IN := TRUE, PT := T#5s), then call T_Gap(IN := T_Startup.Q AND Weld_E_Stop_NC AND Gap_Exceeded, PT := DebounceTime). The second call uses the current-scan T_Startup.Q, so the startup-expiry scan is the first eligible gap sample.\"\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"actions\": \"Assign Weld_Soft_Start_Active := NOT T_Startup.Q. Assign Operator_Alert := T_Startup.Q AND Weld_E_Stop_NC AND Gap_Exceeded AND T_Gap.Q, using current-scan timer results and sampled inputs.\"\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G((Weld_Soft_Start_Active | !Weld_E_Stop_NC | !Gap_Exceeded) -> !Operator_Alert)\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G(!Weld_Soft_Start_Active -> X(!Weld_Soft_Start_Active))\"\n    }\n  ]\n}",
