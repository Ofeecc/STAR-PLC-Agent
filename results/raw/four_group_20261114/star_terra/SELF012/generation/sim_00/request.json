        "declaration": "{attribute 'qualified_only'}\n{attribute 'strict'}\nTYPE E_TaskMode :\n(\n    IDLE := 0,\n    RUNNING := 1,\n    WAIT := 2,\n    LOCKED := 3\n);\nEND_TYPE",
        "implementation": ""
      }
    ]
