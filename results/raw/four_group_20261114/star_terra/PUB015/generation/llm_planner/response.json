   \"valveDStart\": false,\n      \"mixMotorStart\": false,\n      \"autoStart\": false\n    },\n    \"modeSeen\": false,\n    \"previousOpeMode\": false,\n    \"transient_edge_flags\": false,\n    \"modeChanged\": false,\n    \"inputs\": \"Externally supplied; not initialized by the program.\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"actions\": \"Sample inputs. Compute rising edges for all five manual buttons and autoStart from their previous values, then update every button history unconditionally.\"\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"actions\": \"Compute modeChanged from modeSeen and previousOpeMode, then update mode history unconditionally. Apply E-stop reset first and mode-change reset second. Otherwise, in manual mode toggle each latch independently and keep phase IDLE; in automatic mode evaluate exactly one transition from the pre-transition phase. Latch processMode on an accepted autoStart.\"\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls outside CASE/IF\",\n      \"actions\": \"No timer FBs are required; this stage is a no-op. Any future timer FB calls must be unconditional and at top level.\"\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"actions\": \"Assign every output once. Force all FALSE if NOT estop or modeChanged; otherwise select the manual latches when NOT opeMode, or the one-hot output of the resulting automatic phase when opeMode.\"\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G(!estop -> (!valveARun & !valveBRun & !valveCRun & !valveDRun & !mixMotorRun))\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G(opeMode -> (!(valveARun & (valveBRun | valveCRun | valveDRun | mixMotorRun)) & !(valveBRun & (valveCRun | valveDRun | mixMotorRun)) & !(valveCRun & 