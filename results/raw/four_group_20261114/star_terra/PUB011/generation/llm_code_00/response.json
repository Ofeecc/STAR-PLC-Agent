          "logprobs": [],
          "text": "{\n  \"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    {attribute 'analysis' := '-27'}\\n    Mode : BOOL;\\n    ForwardButton : BOOL;\\n    ReverseButton : BOOL;\\n    SensorA : BOOL;\\n    SensorB : BOOL;\\n    SensorC : BOOL;\\n    ButtonA : BOOL;\\n    ButtonB : BOOL;\\n    ButtonC : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    MotorForward : BOOL := FALSE;\\n    MotorReverse : BOOL := FALSE;\\n    CompletionLight : BOOL := FALSE;\\nEND_VAR\\nVAR\\n    phase : E_TaskPhase := E_TaskPhase.WAIT_A;\\nEND_VAR\",\n  \"implementation\": \"IF NOT Mode THEN\\n    phase := E_TaskPhase.WAIT_A;\\nELSE\\n    CASE phase OF\\n        E_TaskPhase.WAIT_A:\\n            IF SensorA AND ButtonA THEN\\n                phase := E_TaskPhase.MOVE_AB;\\n            END_IF;\\n        E_TaskPhase.MOVE_AB:\\n            IF SensorB THEN\\n                phase := E_TaskPhase.WAIT_B;\\n            END_IF;\\n        E_TaskPhase.WAIT_B:\\n            IF SensorB AND ButtonB THEN\\n                phase := E_TaskPhase.MOVE_BC;\\n            END_IF;\\n        E_TaskPhase.MOVE_BC:\\n            IF SensorC THEN\\n                phase := E_TaskPhase.WAIT_C;\\n            END_IF;\\n        E_TaskPhase.WAIT_C:\\n            IF SensorC AND ButtonC THEN\\n                phase := E_TaskPhase.DONE;\\n            END_IF;\\n        E_TaskPhase.DONE:\\n            IF NOT SensorC THEN\\n                phase := E_TaskPhase.WAIT_A;\\n            END_IF;\\n    ELSE\\n        phase := E_TaskPhase.WAIT_A;\\n    END_CASE;\\nEND_IF;\\n\\nMotorForward := (NOT Mode AND ForwardButton AND NOT ReverseButton)\\n    OR (Mode AND ((phase = E_TaskPhase.MOVE_AB) OR (phase = E_TaskPhase.MOVE_BC)));\\nMotorReverse := NOT Mode AND ReverseButton AND NOT ForwardButton;\\nCompletionLight := Mode AND (phase = E_TaskPhase.DONE);\",\n  \"supporting_objects\": [\n    {\n      \"name\": \"E_TaskPhase\",\n      \"kind\": \"DUT\",\n      \"declaration\": \"TYPE E_TaskPhase :\\n(\\n    WAIT_A,\\n    MOVE_AB,\\n    WAIT_B,\\n    MOVE_BC,\\n    WAIT_C,\\n    DONE\\n);\\nEND_TYPE\",\n      \"implementation\": \"\"\n    }\n  ]\n}",
