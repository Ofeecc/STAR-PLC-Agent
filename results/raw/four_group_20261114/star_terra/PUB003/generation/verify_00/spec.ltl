-- Formal verification specification for Task PUB003
-- Generated: 2026-11-14T11:03:20.043054+00:00

-- Property: PUB003.P_init
-- Description: Applies strictly to the fresh pre-invocation initial instance observation before scan k=0 (INITIAL_INSTANCE scope).
LTLSPEC NAME PUB003.P_init := init;

-- Property: PUB003.P1
-- Description: Invalid limits take priority and leave alarms unchanged.
LTLSPEC NAME PUB003.P1 := G(badRange -> (error & status=16#8001 & sameAlarms));

-- Property: PUB003.P2
-- Description: The hysteresis range must be smaller than the limit separation.
LTLSPEC NAME PUB003.P2 := G((!badRange & badWindow) -> (error & status=16#8002 & sameAlarms));

-- Property: PUB003.P3
-- Description: Valid input clears transient configuration errors.
LTLSPEC NAME PUB003.P3 := G(valid -> (!error & status=0));

-- Property: PUB003.P4
-- Description: A high excursion activates the high alarm.
LTLSPEC NAME PUB003.P4 := G((valid & Value>hiLevel) -> hiAlarm);

-- Property: PUB003.P5
-- Description: Below the strict release boundary, high alarm clears.
LTLSPEC NAME PUB003.P5 := G((valid & Value<HighRelease) -> !hiAlarm);

-- Property: PUB003.P6
-- Description: The high hysteresis band retains history.
LTLSPEC NAME PUB003.P6 := G((valid & HighRelease<=Value & Value<=hiLevel) -> (hiAlarm=hiPrev));

-- Property: PUB003.P7
-- Description: A low excursion activates the low alarm.
LTLSPEC NAME PUB003.P7 := G((valid & Value<loLevel) -> loAlarm);

-- Property: PUB003.P8
-- Description: Above the strict low release boundary, low alarm clears.
LTLSPEC NAME PUB003.P8 := G((valid & Value>LowRelease) -> !loAlarm);

-- Property: PUB003.P9
-- Description: The low hysteresis band retains history.
LTLSPEC NAME PUB003.P9 := G((valid & loLevel<=Value & Value<=LowRelease) -> (loAlarm=loPrev));
