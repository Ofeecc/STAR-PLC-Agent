          "text": "{\n  \"state_machine\": [\n    {\n      \"state\": \"INHIBITED\",\n      \"meaning\": \"The signal is invalid; no hold is armed.\",\n      \"transitions\": [\n        \"Invalid signal: remain INHIBITED.\",\n        \"Valid signal without a valid-fault rising edge: go to READY.\",\n        \"Valid-fault rising edge: go to TRACKING and toggle timer selection.\"\n      ]\n    },\n    {\n      \"state\": \"READY\",\n      \"meaning\": \"The signal is valid and no fault has triggered since the last invalid scan.\",\n      \"transitions\": [\n        \"Invalid signal: go to INHIBITED.\",\n        \"Valid-fault rising edge: go to TRACKING and toggle timer selection.\",\n        \"Otherwise: remain READY.\"\n      ]\n    },\n    {\n      \"state\": \"TRACKING\",\n      \"meaning\": \"A fault has triggered since the last invalid scan. The selected timer may be running or expired.\",\n      \"transitions\": [\n        \"Invalid signal: go to INHIBITED.\",\n        \"Valid-fault rising edge: remain TRACKING and toggle timer selection, restarting the hold.\",\n        \"Otherwise: remain TRACKING; timer expiry alone does not change state.\"\n      ]\n    }\n  ],\n  \"timer_plan\": {\n    \"timers\": [\n      {\n        \"name\": \"HoldA\",\n        \"type\": \"TON\",\n        \"PT\": \"T#500ms\",\n        \"IN\": \"THICKNESS_SIGNAL_VALID AND state = TRACKING AND select_A\",\n        \"reset\": \"IN is FALSE, including on invalid signal or selection of HoldB.\"\n      },\n      {\n        \"name\": \"HoldB\",\n        \"type\": \"TON\",\n        \"PT\": \"T#500ms\",\n        \"IN\": \"THICKNESS_SIGNAL_VALID AND state = TRACKING AND NOT select_A\",\n        \"reset\": \"IN is FALSE, including on invalid signal or selection of HoldA.\"\n      }\n    ],\n    \"operation\": \"Toggle select_A on every valid-fault rising edge. The newly selected timer was disabled on the preceding scan, so its unconditional call starts at elapsed zero on the trigger scan. Alternation permits a fresh edge to restart the hold without calling a timer twice. Hold is active when TRACKING and the selected timer's Q is FALSE; it ends at 500 ms, unless invalidity cancels it sooner. Use elapsed timer time, not CycleTime, for the hold.\"\n  },\n  \"priorities\": [\n    \"Signal invalidity immediately suppresses the alarm, cancels the hold, and prevents recording and runtime accumulation; existing statistics are preserved.\",\n    \"With a valid signal, a persistent fault keeps the alarm on regardless of timer expiry.\",\n    \"Every valid-fault rising edge records an occurrence and restarts the minimum hold.\",\n    \"Statistics and history are observational only and never affect cutting permissives. Expose history as read-only to callers.\",\n    \"UINT counter and LTIME runtime overflow are outside the bounded cases; establish a separate deployment policy.\"\n  ],\n  \"initial_values\": {\n    \"pre_invocation_outputs\": {\n      \"THICKNESS_ALARM\": false,\n      \"Slab_Fault_Counter\": 0,\n      \"Slab_Runtime_Accumulator\": \"LTIME#0ns\",\n      \"Slab_Fault_History\": [0, 0, 0, 0, 0]\n    },\n    \"internal\": {\n      \"state\": \"INHIBITED\",\n      \"previous_valid_fault\": false,\n      \"select_A\": false,\n      \"statistics_registers\": \"Zero counter, runtime, and all five history elements.\",\n      \"timers\": \"Both TON instances initialized reset: Q = FALSE and ET = T#0ms.\"\n    },\n    \"note\": \"Initialization occurs before the first invocation; do not reinitialize statistics on the first scan or on signal loss.\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"actions\": [\n        \"Sample all inputs. Compute valid_fault = THICKNESS_SIGNAL_VALID AND THICKNESS_FAULT and rise = valid_fault AND NOT previous_valid_fault.\",\n        \"Set previous_valid_fault = valid_fault each scan, including invalid scans. Thus a fault present when validity returns is a new occurrence.\"\n      ]\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"actions\": [\n        \"Apply invalidity first: enter INHIBITED and cancel the logical hold. Otherwise apply the state transitions and toggle select_A on rise.\",\n        \"On rise, increment the internal counter once; shift history from index 3 to 4 down through index 0 to 1, then write the sampled FaultTimestamp to index 0.\",\n        \"When CUTTING_RUN AND THICKNESS_SIGNAL_VALID AND NOT THICKNESS_FAULT, add the current positive CycleTime to internal runtime after an exact widening to LTIME. Otherwise preserve runtime. This includes a qualifying first invocation.\"\n      ]\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls\",\n      \"actions\": [\n        \"Call HoldA and HoldB exactly once each scan, outside CASE and IF, using their specified IN expressions and PT values.\",\n        \"Read the selected timer's updated Q for this scan; timer expiry must affect the same observed scan.\"\n      ]\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"actions\": [\n        \"Assign THICKNESS_ALARM = THICKNESS_SIGNAL_VALID AND (THICKNESS_FAULT OR (state = TRACKING AND NOT selected_timer.Q)).\",\n        \"Assign the counter, runtime and history outputs from their internal registers in one output section.\"\n      ]\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G(!THICKNESS_SIGNAL_VALID -> !THICKNESS_ALARM)\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G((THICKNESS_SIGNAL_VALID & THICKNESS_FAULT) -> THICKNESS_ALARM)\"\n    }\n  ]\n}",
