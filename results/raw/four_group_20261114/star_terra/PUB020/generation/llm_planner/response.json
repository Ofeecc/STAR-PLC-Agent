          "text": "{\n  \"state_machine\": [\n    {\n      \"state\": \"WAIT_FEED\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorFeed\",\n          \"next\": \"MOVE_TO_WASH\"\n        }\n      ]\n    },\n    {\n      \"state\": \"MOVE_TO_WASH\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorWash\",\n          \"next\": \"WAIT_WASH\"\n        }\n      ]\n    },\n    {\n      \"state\": \"WAIT_WASH\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorWash AND washComplete\",\n          \"next\": \"MOVE_TO_WEIGHT\"\n        }\n      ]\n    },\n    {\n      \"state\": \"MOVE_TO_WEIGHT\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorWeight\",\n          \"next\": \"WAIT_WEIGHT\"\n        }\n      ]\n    },\n    {\n      \"state\": \"WAIT_WEIGHT\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorWeight AND weightComplete AND 100.0 <= real32(weight) <= 200.0\",\n          \"action\": \"Latch firingTemp = real32(500.0 + real32(real32(weight - 100.0) * 0.5)).\",\n          \"next\": \"MOVE_TO_FIRING\"\n        },\n        {\n          \"condition\": \"SensorWeight AND weightComplete AND weight is outside the inclusive range\",\n          \"next\": \"REJECT\"\n        }\n      ]\n    },\n    {\n      \"state\": \"REJECT\",\n      \"transitions\": [\n        {\n          \"condition\": \"NOT SensorWeight\",\n          \"next\": \"WAIT_FEED\"\n        }\n      ]\n    },\n    {\n      \"state\": \"MOVE_TO_FIRING\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorFiring\",\n          \"next\": \"WAIT_FIRING\"\n        }\n      ]\n    },\n    {\n      \"state\": \"WAIT_FIRING\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorFiring AND firingComplete\",\n          \"next\": \"MOVE_TO_OUTPUT\"\n        }\n      ]\n    },\n    {\n      \"state\": \"MOVE_TO_OUTPUT\",\n      \"transitions\": [\n        {\n          \"condition\": \"SensorOutput\",\n          \"next\": \"OUTPUT_DONE\"\n        }\n      ]\n    },\n    {\n      \"state\": \"OUTPUT_DONE\",\n      \"transitions\": [\n        {\n          \"condition\": \"NOT SensorOutput\",\n          \"next\": \"WAIT_FEED\"\n        }\n      ]\n    }\n  ],\n  \"timer_plan\": {\n    \"timers\": [],\n    \"note\": \"No timing requirement is specified. Do not introduce rejection pulses, travel timeouts, or reversal delays without an approved specification.\"\n  },\n  \"priorities\": [\n    \"Manual mode overrides the automatic route: set phase to WAIT_FEED, clear kick and CompletionLight, and retain firingTemp. Manual forward and reverse requests are mutually exclusive; simultaneous requests inhibit both.\",\n    \"Automatic mode permits forward motion only. Evaluate at most one phase transition per invocation, using the pre-transition phase. Destination arrival stops motion in the same invocation; a completion already asserted on arrival is not accepted until a later invocation.\",\n    \"Accept completion levels only in their corresponding wait state and only while the matching station sensor is true. Ignore unrelated confirmations.\",\n    \"An out-of-range item enters REJECT immediately, remains stopped with kick asserted while SensorWeight is true, and cannot proceed to firing.\",\n    \"Mode entry uses the reset WAIT_FEED phase; SensorFeed may start the route on that invocation. A reset or transition to WAIT_FEED from another phase does not also start a new route in the same invocation.\",\n    \"The design assumes one product and noncontradictory station sensors. Motor interlocking in application logic is not a substitute for an independently engineered safety circuit and contactor interlocks.\"\n  ],\n  \"initial_values\": {\n    \"phase\": \"WAIT_FEED\",\n    \"MotorForward\": false,\n    \"MotorReverse\": false,\n    \"kick\": false,\n    \"CompletionLight\": false,\n    \"firingTemp\": 0.0,\n    \"previousMode\": false\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"details\": \"Sample all inputs once; update previousMode and mode-edge indications unconditionally. Completion and sensor conditions are sampled levels, not required edges.\"\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"details\": \"Apply the manual reset priority or evaluate one automatic transition from the applicable pre-transition phase. Latch the setpoint only on a qualified WAIT_WEIGHT judgment. Use binary32 rounding at each indicated arithmetic operation; otherwise retain the previous setpoint.\"\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls outside CASE/IF\",\n      \"details\": \"There are no timer FBs in this design, so this stage has zero calls. Any subsequently approved timer FB must be called once per scan here, outside CASE/IF.\"\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"details\": \"Assign outputs once from the sampled inputs and post-transition phase. In manual: MotorForward = ForwardButton AND NOT ReverseButton; MotorReverse = ReverseButton AND NOT ForwardButton; kick and CompletionLight are false. In automatic: MotorForward is true exactly in the four MOVE states; MotorReverse is false; kick is true exactly in REJECT; CompletionLight is true exactly in OUTPUT_DONE. Assign firingTemp from the retained setpoint. Thus transitions affect outputs in the same invocation.\"\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G(!(MotorForward & MotorReverse))\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G(!Mode -> ((MotorForward <-> (ForwardButton & !ReverseButton)) & (MotorReverse <-> (ReverseButton & !ForwardButton))))\"\n    },\n    {\n      \"id\": \"A3\",\n      \"formula\": \"G(Mode -> !MotorReverse)\"\n    },\n    {\n      \"id\": \"A4\",\n      \"formula\": \"G(!Mode -> (!kick & !CompletionLight))\"\n    },\n    {\n      \"id\": \"A5\",\n      \"formula\": \"G(kick -> (Mode & SensorWeight & !MotorForward & !MotorReverse))\"\n    },\n    {\n      \"id\": \"A6\",\n      \"formula\": \"G(CompletionLight -> (Mode & SensorOutput & !MotorForward & !MotorReverse))\"\n    }\n  ]\n}",
