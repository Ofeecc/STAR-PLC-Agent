          "annotations": [],
          "logprobs": [],
          "text": "{\n  \"state_machine\": [\n    {\n      \"state\": \"IDLE\",\n      \"description\": \"No automatic action is active. Manual control is a combinational output overlay, not a sequencer state.\",\n      \"transitions\": [\n        \"In an automatic mode, a fresh Start edge with UpLimitSwitch and LeftLimitSwitch TRUE starts action 1 and enters RUNNING.\",\n        \"Otherwise remain IDLE. A rejected Start edge is not queued.\"\n      ]\n    },\n    {\n      \"state\": \"RUNNING\",\n      \"description\": \"Exactly one automatic action is active. Actions 1 through 8 are DOWN, GRIP, UP1, RIGHT, DOWN2, RELEASE, UP2, LEFT. Their respective completion inputs are DownLimitSwitch, GripLimitSwitch, UpLimitSwitch, RightLimitSwitch, DownLimitSwitch, ReleaseLimitSwitch, UpLimitSwitch, LeftLimitSwitch.\",\n      \"transitions\": [\n        \"Without matching completion feedback, remain in the current action; ignore Start edges.\",\n        \"On matching feedback in SingleStepMode, stop the action. After actions 1–7, increment next_step and enter WAIT_STEP; after action 8, set next_step to 1 and enter IDLE.\",\n        \"On matching feedback in SingleCycleMode or ContinuousMode after actions 1–7, advance to the next action in the same scan.\",\n        \"After action 8, SingleCycleMode enters IDLE with next_step 1; ContinuousMode wraps directly to action 1 in the same scan.\"\n      ]\n    },\n    {\n      \"state\": \"WAIT_STEP\",\n      \"description\": \"Single-step action completed; all outputs are off and next_step identifies the next action.\",\n      \"transitions\": [\n        \"A fresh Start edge starts next_step and enters RUNNING.\",\n        \"Without a fresh edge, remain waiting. The top-left pose check applies to the start of action 1, not to intermediate steps.\"\n      ]\n    }\n  ],\n  \"timer_plan\": {\n    \"required\": [],\n    \"PT_durations\": \"None.\",\n    \"reset_conditions\": \"Not applicable.\",\n    \"rationale\": \"All action completion is feedback-driven; no timeout or delay is specified.\"\n  },\n  \"priorities\": [\n    \"EmergencyStop FALSE overrides everything: turn all outputs off and cancel the sequence. Do not clear a selected mode solely because of emergency stop. Automatic recovery requires a fresh Start edge and the top-left pose.\",\n    \"After emergency stop priority, a mode change after the first invocation resets the sequence and suppresses all commands for that invocation. No selected mode also resets the sequence and turns all outputs off. The first invocation establishes the selected mode without a mode-change suppression scan.\",\n    \"The caller must select at most one mode. A host/test wrapper rejects multiple selected modes with ValueError; a PLC implementation should also fail off if this contract is violated.\",\n    \"Opposing manual buttons inhibit both commands in their pair, regardless of limit states. Independent non-opposing manual actions may operate simultaneously.\",\n    \"Each completion input immediately suppresses its corresponding output. Automatic operation requests at most one action at a time.\",\n    \"Start edges during an active action, including its completion scan, are discarded. Edge history still updates during emergency stop, mode changes, and inactive modes.\",\n    \"Provide an independently engineered, safety-rated emergency-stop system and assess mechanical braking and payload retention; ordinary PLC command logic alone is not a safety function.\"\n  ],\n  \"initial_values\": {\n    \"outputs\": {\n      \"MoveDown\": false,\n      \"MoveUp\": false,\n      \"MoveLeft\": false,\n      \"MoveRight\": false,\n      \"ActivateGrip\": false,\n      \"ActivateRelease\": false\n    },\n    \"state\": \"IDLE\",\n    \"next_step\": 1,\n    \"busy\": false,\n    \"previous_Start\": false,\n    \"arm_mode\": \"NONE until the first invocation establishes the sampled selection\",\n    \"first_invocation\": true,\n    \"initial_pose\": \"Top left; physical UpLimitSwitch and LeftLimitSwitch feedback must confirm the pose before starting a new automatic sequence.\"\n  },\n  \"scan_execution_order\": [\n    {\n      \"stage\": 1,\n      \"name\": \"Edge sampling\",\n      \"actions\": [\n        \"Sample all inputs once. Compute Start rising edge from sampled Start and previous_Start, then update previous_Start on every invocation.\",\n        \"Determine the selected mode and whether it differs from the previous invocation; modeChanged is FALSE on the first invocation. Update arm_mode even when emergency stop is active.\"\n      ]\n    },\n    {\n      \"stage\": 2,\n      \"name\": \"Safety/reset priority and state transitions\",\n      \"actions\": [\n        \"Apply emergency stop first, then mode-change and no-mode resets. Each reset sets state to IDLE, next_step to 1, and busy to FALSE; suppress outputs for the applicable scan.\",\n        \"Otherwise evaluate at most one sequencer transition using the pre-scan state and sampled feedback. On an accepted start, enter RUNNING without also processing completion in that invocation.\",\n        \"On automatic completion, select the next phase in this scan where required. If its feedback is already TRUE, its output is suppressed now and its completion is processed on the next invocation.\",\n        \"In manual mode keep the sequencer reset; calculate manual requests from buttons and opposing-button interlocks.\"\n      ]\n    },\n    {\n      \"stage\": 3,\n      \"name\": \"Unconditional top-level timer FB calls outside CASE/IF\",\n      \"actions\": [\n        \"No timer FBs are required, so there are no calls. Any timers added by a future approved design must be called unconditionally at this stage outside CASE/IF.\"\n      ]\n    },\n    {\n      \"stage\": 4,\n      \"name\": \"Unified output assignments\",\n      \"actions\": [\n        \"Assign all six outputs exactly once from the post-transition automatic phase or manual requests, gated by emergency stop, mode-change suppression, valid mode, opposing-command interlocks, and each command's own completion feedback.\",\n        \"Single-step completion and single-cycle completion produce all outputs off in the completion scan; continuous wrapping requests DOWN in that scan subject to DownLimitSwitch.\"\n      ]\n    }\n  ],\n  \"formal_assertions\": [\n    {\n      \"id\": \"A1\",\n      \"formula\": \"G(!EmergencyStop -> (!MoveDown & !MoveUp & !MoveLeft & !MoveRight & !ActivateGrip & !ActivateRelease))\"\n    },\n    {\n      \"id\": \"A2\",\n      \"formula\": \"G((!ManualMode & !SingleStepMode & !SingleCycleMode & !ContinuousMode) -> (!MoveDown & !MoveUp & !MoveLeft & !MoveRight & !ActivateGrip & !ActivateRelease))\"\n    },\n    {\n      \"id\": \"A3\",\n      \"formula\": \"G(!(MoveDown & MoveUp) & !(MoveLeft & MoveRight) & !(ActivateGrip & ActivateRelease))\"\n    },\n    {\n      \"id\": \"A4\",\n      \"formula\": \"G((DownLimitSwitch -> !MoveDown) & (UpLimitSwitch -> !MoveUp) & (LeftLimitSwitch -> !MoveLeft) & (RightLimitSwitch -> !MoveRight) & (GripLimitSwitch -> !ActivateGrip) & (ReleaseLimitSwitch -> !ActivateRelease))\"\n    }\n  ]\n}",
