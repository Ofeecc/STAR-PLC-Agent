-- Formal verification specification for Task SELF002
-- Generated: 2026-11-14T10:42:40.919009+00:00

-- Property: SELF002.P_init
-- Description: Applies strictly to the fresh pre-invocation initial instance observation before scan k=0 (INITIAL_INSTANCE scope).
LTLSPEC NAME SELF002.P_init := init;

-- Property: SELF002.P1
-- Description: Direction outputs are mutually exclusive.
LTLSPEC NAME SELF002.P1 := G(!(Forward & Reverse));

-- Property: SELF002.P2
-- Description: Invalid or stopped requests produce neutral.
LTLSPEC NAME SELF002.P2 := G((Stop | (ForwardButton <-> ReverseButton)) -> (!Forward & !Reverse));

-- Property: SELF002.P3
-- Description: Reversal from reverse has one neutral output scan.
LTLSPEC NAME SELF002.P3 := G((fwdOnly & qReverse) -> (!Forward & !Reverse));

-- Property: SELF002.P4
-- Description: Reversal from forward has one neutral output scan.
LTLSPEC NAME SELF002.P4 := G((revOnly & qForward) -> (!Forward & !Reverse));

-- Property: SELF002.P5
-- Description: A permitted forward jog operates immediately.
LTLSPEC NAME SELF002.P5 := G((fwdOnly & !qReverse) -> Forward);

-- Property: SELF002.P6
-- Description: A permitted reverse jog operates immediately.
LTLSPEC NAME SELF002.P6 := G((revOnly & !qForward) -> Reverse);
