    "declaration": "FUNCTION_BLOCK FB_Task\nVAR_INPUT\n    Demand : BOOL;\n    FaultA : BOOL;\n    FaultB : BOOL;\nEND_VAR\nVAR_OUTPUT\n    PumpA : BOOL := FALSE;\n    PumpB : BOOL := FALSE;\n    LeadA : BOOL := TRUE;\nEND_VAR\nVAR\n    LeadA_State : BOOL := TRUE;\n    previous_demand : BOOL := FALSE;\n    served : BOOL := FALSE;\n    PumpCmdA : BOOL := FALSE;\n    PumpCmdB : BOOL := FALSE;\n    scanDemand : BOOL := FALSE;\n    scanFaultA : BOOL := FALSE;\n    scanFaultB : BOOL := FALSE;\n    fallingEdge : BOOL := FALSE;\nEND_VAR",
    "implementation": "scanDemand := Demand;\nscanFaultA := FaultA;\nscanFaultB := FaultB;\nfallingEdge := previous_demand AND NOT scanDemand;\n\nIF NOT scanDemand THEN\n    PumpCmdA := FALSE;\n    PumpCmdB := FALSE;\n    IF fallingEdge AND served THEN\n        LeadA_State := NOT LeadA_State;\n    END_IF;\n    served := FALSE;\nELSE\n    IF LeadA_State THEN\n        IF NOT scanFaultA THEN\n            PumpCmdA := TRUE;\n            PumpCmdB := FALSE;\n        ELSIF NOT scanFaultB THEN\n            PumpCmdA := FALSE;\n            PumpCmdB := TRUE;\n        ELSE\n            PumpCmdA := FALSE;\n            PumpCmdB := FALSE;\n        END_IF;\n    ELSE\n        IF NOT scanFaultB THEN\n            PumpCmdA := FALSE;\n            PumpCmdB := TRUE;\n        ELSIF NOT scanFaultA THEN\n            PumpCmdA := TRUE;\n            PumpCmdB := FALSE;\n        ELSE\n            PumpCmdA := FALSE;\n            PumpCmdB := FALSE;\n        END_IF;\n    END_IF;\n    IF PumpCmdA OR PumpCmdB THEN\n        served := TRUE;\n    END_IF;\nEND_IF;\n\nprevious_demand := scanDemand;\n\nPumpA := PumpCmdA;\nPumpB := PumpCmdB;\nLeadA := LeadA_State;",
