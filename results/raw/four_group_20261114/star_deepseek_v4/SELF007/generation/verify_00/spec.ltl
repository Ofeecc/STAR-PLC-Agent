-- Property: SELF007.P_init
-- Description: Applies strictly to the fresh pre-invocation initial instance observation before scan k=0 (INITIAL_INSTANCE scope).
LTLSPEC NAME SELF007.P_init := init;

-- Property: SELF007.P1
-- Description: At most one pump runs.
LTLSPEC NAME SELF007.P1 := G(!(PumpA & PumpB));

-- Property: SELF007.P2
-- Description: A cannot run without demand or with its fault.
LTLSPEC NAME SELF007.P2 := G((!Demand | FaultA) -> !PumpA);

-- Property: SELF007.P3
-- Description: B cannot run without demand or with its fault.
LTLSPEC NAME SELF007.P3 := G((!Demand | FaultB) -> !PumpB);

-- Property: SELF007.P4
-- Description: A is selected when it is the healthy lead.
LTLSPEC NAME SELF007.P4 := G((Demand & LeadA & !FaultA) -> PumpA);

-- Property: SELF007.P5
-- Description: B is selected when it is the healthy lead.
LTLSPEC NAME SELF007.P5 := G((Demand & !LeadA & !FaultB) -> PumpB);

-- Property: SELF007.P6
-- Description: Toggle once on a served demand's falling edge.
LTLSPEC NAME SELF007.P6 := G(completedServed -> (LeadA <-> !qLeadA));

-- Property: SELF007.P7
-- Description: Unserved episodes and held demand preserve preference.
LTLSPEC NAME SELF007.P7 := G(!completedServed -> (LeadA <-> qLeadA));

-- Property: SELF007.P8
-- Description: Explicit correction of a demonstrated omission.
LTLSPEC NAME SELF007.P8 := G((Demand & FaultA & !FaultB) -> PumpB);

-- Property: SELF007.P9
-- Description: Explicit correction of a demonstrated omission.
LTLSPEC NAME SELF007.P9 := G((Demand & FaultB & !FaultA) -> PumpA);
