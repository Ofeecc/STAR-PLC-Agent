    "implementation": "rise := Fault AND NOT previous_fault;\nprevious_fault := Fault;\n\nIF Reset AND NOT Fault THEN\n    Alarm := FALSE;\n    Acknowledged := FALSE;\nELSIF Fault THEN\n    Alarm := TRUE;\n    IF rise THEN\n        Acknowledged := FALSE;\n    ELSIF Ack THEN\n        Acknowledged := TRUE;\n    END_IF;\nELSE\n    IF Alarm AND Ack THEN\n        Acknowledged := TRUE;\n    END_IF;\nEND_IF;\n\nHorn := Alarm AND NOT Acknowledged;",
    "supporting_objects": []
  },
