    "declaration": "FUNCTION_BLOCK FB_Task\nVAR_INPUT\n    Request : BOOL;\n    Trip : BOOL;\n    Preset : USINT;\nEND_VAR\nVAR_OUTPUT\n    Ready : BOOL := FALSE;\n    Count : USINT := 0;\nEND_VAR\nVAR\n    validPreset : BOOL;\nEND_VAR",
    "implementation": "validPreset := (Preset >= 1) AND (Preset <= 5);\n\nIF Trip OR (NOT Request) OR (NOT validPreset) THEN\n    Count := 0;\n    Ready := FALSE;\nELSE\n    IF Count < Preset THEN\n        Count := Count + 1;\n    ELSE\n        Count := Preset;\n    END_IF;\n    Ready := (Count >= Preset);\nEND_IF;",
    "supporting_objects": []
  },
