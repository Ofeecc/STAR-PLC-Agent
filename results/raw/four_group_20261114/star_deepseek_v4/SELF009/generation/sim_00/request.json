    "declaration": "FUNCTION_BLOCK FB_Task\nVAR_INPUT\n    PartPulse : BOOL;\n    Reset : BOOL;\n    Target : USINT;\nEND_VAR\nVAR_OUTPUT\n    Count : USINT := 0;\n    Complete : BOOL := FALSE;\n    {attribute 'analysis' := '-27'}\n    Error : BOOL := FALSE;\nEND_VAR\nVAR\n    previous_pulse : BOOL := FALSE;\n    rise : BOOL := FALSE;\n    invalidTarget : BOOL := FALSE;\n    nextCount : USINT := 0;\n    nextComplete : BOOL := FALSE;\n    nextError : BOOL := FALSE;\nEND_VAR",
    "implementation": "rise := PartPulse AND NOT previous_pulse;\nprevious_pulse := PartPulse;\n\ninvalidTarget := (Target < 1) OR (Target > 20);\n\nIF invalidTarget THEN\n    nextCount := 0;\n    nextComplete := FALSE;\n    nextError := TRUE;\nELSIF Reset THEN\n    nextCount := 0;\n    nextComplete := FALSE;\n    nextError := FALSE;\nELSE\n    nextCount := Count;\n    IF rise THEN\n        IF nextCount < Target THEN\n            nextCount := nextCount + 1;\n        ELSE\n            nextCount := Target;\n        END_IF;\n    ELSE\n        IF nextCount > Target THEN\n            nextCount := Target;\n        END_IF;\n    END_IF;\n    nextComplete := (nextCount >= Target);\n    nextError := FALSE;\nEND_IF;\n\nCount := nextCount;\nComplete := nextComplete;\nError := nextError;",
