    "declaration": "{attribute 'analysis' := 'off'}\n{attribute 'no_analysis'}\n{attribute 'no_static_analysis'}\nFUNCTION_BLOCK FB_Task\nVAR_INPUT\n    cyclicExecution : BOOL;\n    trigger : BOOL;\n    value : LREAL;\n    windowSize : INT;\n    reset : BOOL;\nEND_VAR\nVAR_OUTPUT\n    average : LREAL := 0.0;\n    windowSizeReached : BOOL := FALSE;\n    error : BOOL := FALSE;\n    status : WORD := 16#0000;\nEND_VAR\nVAR\n    history : ARRAY[0..99] OF LREAL;\n    historyCount : INT := 0;\n    writeIndex : INT := 0;\n    lastValidWindowSize : INT := 0;\n    previousTrigger : BOOL := FALSE;\n    i : INT;\n    sampleSum : LREAL;\n    triggerRise : BOOL;\n    windowChanged : BOOL;\n    validWindow : BOOL;\nEND_VAR",
