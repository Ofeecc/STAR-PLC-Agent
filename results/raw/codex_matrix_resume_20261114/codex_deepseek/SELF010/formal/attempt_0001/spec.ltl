-- Property: SELF010.P_init
-- Description: Applies strictly to the fresh pre-invocation initial instance observation before scan k=0 (INITIAL_INSTANCE scope).
LTLSPEC NAME SELF010.P_init := init;

-- Property: SELF010.P1
-- Description: Horn follows the latched acknowledgment state.
LTLSPEC NAME SELF010.P1 := G(Horn <-> (Alarm & !Acknowledged));

-- Property: SELF010.P2
-- Description: A present fault cannot be reset away.
LTLSPEC NAME SELF010.P2 := G(Fault -> Alarm);

-- Property: SELF010.P3
-- Description: Every new event annunciates despite simultaneous Ack.
LTLSPEC NAME SELF010.P3 := G(rise -> (Alarm & !Acknowledged & Horn));

-- Property: SELF010.P4
-- Description: Reset clears a removed fault.
LTLSPEC NAME SELF010.P4 := G((Reset & !Fault) -> (!Alarm & !Acknowledged & !Horn));

-- Property: SELF010.P5
-- Description: Fault disappearance does not clear the visible alarm.
LTLSPEC NAME SELF010.P5 := G((!Fault & !Reset & qAlarm) -> Alarm);

-- Property: SELF010.P6
-- Description: Acknowledgment silences a retained event.
LTLSPEC NAME SELF010.P6 := G((!rise & !(Reset & !Fault) & Ack & qAlarm) -> Acknowledged);

-- Property: SELF010.P7
-- Description: Forbids spontaneous alarm or pre-acknowledgment on idle scans.
LTLSPEC NAME SELF010.P7 := G(!Fault & !qAlarm -> (!Alarm & !Acknowledged & !Horn));

-- Property: SELF010.P8
-- Description: Preserves acknowledgment retention without requiring CompleteBehavior.
LTLSPEC NAME SELF010.P8 := G((qAlarm & !(Reset & !Fault) & !rise & !Ack) -> (Acknowledged <-> qAck));

-- Property: SELF010.COMPLETE
-- Description: Every constrained ACTUAL output satisfies the exact pinned input-driven reference transition and comparison policy. Finite observations can falsify this predicate; no completed unbounded proof is claimed.
LTLSPEC NAME SELF010.COMPLETE := G(CompleteBehavior);
