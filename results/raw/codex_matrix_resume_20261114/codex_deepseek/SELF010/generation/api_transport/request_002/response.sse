data: {"type":"response.output_text.done","content_index":0,"item_id":"msg_02179466402010800000000000000000000ffffac15d3ad4ef621","output_index":1,"text":"{\"declaration\":\"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Fault : BOOL;\\n    Ack : BOOL;\\n    Reset : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    Alarm : BOOL := FALSE;\\n    Acknowledged : BOOL := FALSE;\\n    Horn : BOOL := FALSE;\\nEND_VAR\\nVAR\\n    previous_fault : BOOL := FALSE;\\nEND_VAR\",\"implementation\":\"IF Reset AND NOT Fault THEN\\n    Alarm := FALSE;\\n    Acknowledged := FALSE;\\nELSIF Fault THEN\\n    Alarm := TRUE;\\n    IF NOT previous_fault THEN\\n        Acknowledged := FALSE;\\n    ELSIF Ack THEN\\n        Acknowledged := TRUE;\\n    END_IF;\\nELSE\\n    IF Alarm AND Ack THEN\\n        Acknowledged := TRUE;\\n    END_IF;\\nEND_IF;\\n\\nHorn := Alarm AND NOT Acknowledged;\\nprevious_fault := Fault;\",\"supporting_objects\":[]}","sequence_number":695}

