data: {"type":"response.output_text.done","content_index":0,"item_id":"msg_02179466343458400000000000000000000ffffac150238507a89","output_index":1,"text":"{\"declaration\":\"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    ManualMode : BOOL;\\n    SingleStepMode : BOOL;\\n    SingleCycleMode : BOOL;\\n    ContinuousMode : BOOL;\\n    EmergencyStop : BOOL;\\n    Start : BOOL;\\n    DownButton : BOOL;\\n    UpButton : BOOL;\\n    LeftButton : BOOL;\\n    RightButton : BOOL;\\n    GripButton : BOOL;\\n    ReleaseButton : BOOL;\\n    DownLimitSwitch : BOOL;\\n    UpLimitSwitch : BOOL;\\n    LeftLimitSwitch : BOOL;\\n    RightLimitSwitch : BOOL;\\n    GripLimitSwitch : BOOL;\\n    ReleaseLimitSwitch : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    MoveDown : BOOL;\\n    MoveUp : BOOL;\\n    MoveLeft : BOOL;\\n    MoveRight : BOOL;\\n    ActivateGrip : BOOL;\\n    ActivateRelease : BOOL;\\nEND_VAR\\nVAR\\n    PrevMode : INT := 0;\\n    FirstScan : BOOL := TRUE;\\n    NextAction : INT := 1;\\n    Busy : BOOL := FALSE;\\n    StartPrev : BOOL := FALSE;\\n    SelectedMode : INT;\\n    ModeChanged : BOOL;\\n    StartEdge : BOOL;\\n    Done : BOOL;\\n    ReqDown : BOOL;\\n    ReqUp : BOOL;\\n    ReqLeft : BOOL;\\n    ReqRight : BOOL;\\n    ReqGrip : BOOL;\\n    ReqRelease : BOOL;\\nEND_VAR\",\"implementation\":\"SelectedMode := 0;\\nIF ManualMode THEN\\n    SelectedMode := 1;\\nELSIF SingleStepMode THEN\\n    SelectedMode := 2;\\nELSIF SingleCycleMode THEN\\n    SelectedMode := 3;\\nELSIF ContinuousMode THEN\\n    SelectedMode := 4;\\nEND_IF\\n\\nModeChanged := (NOT FirstScan) AND (SelectedMode <> PrevMode);\\nStartEdge := Start AND NOT StartPrev;\\n\\nReqDown := FALSE;\\nReqUp := FALSE;\\nReqLeft := FALSE;\\nReqRight := FALSE;\\nReqGrip := FALSE;\\nReqRelease := FALSE;\\nDone := FALSE;\\n\\nIF NOT EmergencyStop THEN\\n    Busy := FALSE;\\n    NextAction := 1;\\nELSIF SelectedMode = 0 THEN\\n    Busy := FALSE;\\n    NextAction := 1;\\nELSIF ModeChanged THEN\\n    Busy := FALSE;\\n    NextAction := 1;\\nELSE\\n    CASE SelectedMode OF\\n    1:\\n        Busy := FALSE;\\n        NextAction := 1;\\n        ReqDown := DownButton AND NOT UpButton;\\n        ReqUp := UpButton AND NOT DownButton;\\n        ReqLeft := LeftButton AND NOT RightButton;\\n        ReqRight := RightButton AND NOT LeftButton;\\n        ReqGrip := GripButton AND NOT ReleaseButton;\\n        ReqRelease := ReleaseButton AND NOT GripButton;\\n    2:\\n        IF Busy THEN\\n            CASE NextAction OF\\n            1: Done := DownLimitSwitch;\\n            2: Done := GripLimitSwitch;\\n            3: Done := UpLimitSwitch;\\n            4: Done := RightLimitSwitch;\\n            5: Done := DownLimitSwitch;\\n            6: Done := ReleaseLimitSwitch;\\n            7: Done := UpLimitSwitch;\\n            8: Done := LeftLimitSwitch;\\n            ELSE Done := FALSE;\\n            END_CASE\\n            IF Done THEN\\n                Busy := FALSE;\\n                NextAction := NextAction + 1;\\n                IF NextAction > 8 THEN\\n                    NextAction := 1;\\n                END_IF\\n            ELSE\\n                CASE NextAction OF\\n                1: ReqDown := TRUE;\\n                2: ReqGrip := TRUE;\\n                3: ReqUp := TRUE;\\n                4: ReqRight := TRUE;\\n                5: ReqDown := TRUE;\\n                6: ReqRelease := TRUE;\\n                7: ReqUp := TRUE;\\n                8: ReqLeft := TRUE;\\n                END_CASE\\n            END_IF\\n        ELSE\\n            IF StartEdge AND ((NextAction <> 1) OR (UpLimitSwitch AND LeftLimitSwitch)) THEN\\n                Busy := TRUE;\\n                CASE NextAction OF\\n                1: ReqDown := TRUE;\\n                2: ReqGrip := TRUE;\\n                3: ReqUp := TRUE;\\n                4: ReqRight := TRUE;\\n                5: ReqDown := TRUE;\\n                6: ReqRelease := TRUE;\\n                7: ReqUp := TRUE;\\n                8: ReqLeft := TRUE;\\n                END_CASE\\n            END_IF\\n        END_IF\\n    3:\\n        IF Busy THEN\\n            CASE NextAction OF\\n            1: Done := DownLimitSwitch;\\n            2: Done := GripLimitSwitch;\\n            3: Done := UpLimitSwitch;\\n            4: Done := RightLimitSwitch;\\n            5: Done := DownLimitSwitch;\\n            6: Done := ReleaseLimitSwitch;\\n            7: Done := UpLimitSwitch;\\n            8: Done := LeftLimitSwitch;\\n            ELSE Done := FALSE;\\n            END_CASE\\n            IF Done THEN\\n                IF NextAction = 8 THEN\\n                    Busy := FALSE;\\n                    NextAction := 1;\\n                ELSE\\n                    NextAction := NextAction + 1;\\n                    CASE NextAction OF\\n                    1: ReqDown := TRUE;\\n                    2: ReqGrip := TRUE;\\n                    3: ReqUp := TRUE;\\n                    4: ReqRight := TRUE;\\n                    5: ReqDown := TRUE;\\n                    6: ReqRelease := TRUE;\\n                    7: ReqUp := TRUE;\\n                    8: ReqLeft := TRUE;\\n                    END_CASE\\n                END_IF\\n            ELSE\\n                CASE NextAction OF\\n                1: ReqDown := TRUE;\\n                2: ReqGrip := TRUE;\\n                3: ReqUp := TRUE;\\n                4: ReqRight := TRUE;\\n                5: ReqDown := TRUE;\\n                6: ReqRelease := TRUE;\\n                7: ReqUp := TRUE;\\n                8: ReqLeft := TRUE;\\n                END_CASE\\n            END_IF\\n        ELSE\\n            IF StartEdge AND UpLimitSwitch AND LeftLimitSwitch THEN\\n                Busy := TRUE;\\n                NextAction := 1;\\n                ReqDown := TRUE;\\n            END_IF\\n        END_IF\\n    4:\\n        IF Busy THEN\\n            CASE NextAction OF\\n            1: Done := DownLimitSwitch;\\n            2: Done := GripLimitSwitch;\\n            3: Done := UpLimitSwitch;\\n            4: Done := RightLimitSwitch;\\n            5: Done := DownLimitSwitch;\\n            6: Done := ReleaseLimitSwitch;\\n            7: Done := UpLimitSwitch;\\n            8: Done := LeftLimitSwitch;\\n            ELSE Done := FALSE;\\n            END_CASE\\n            IF Done THEN\\n                IF NextAction = 8 THEN\\n                    NextAction := 1;\\n                    Busy := TRUE;\\n                    ReqDown := TRUE;\\n                ELSE\\n                    NextAction := NextAction + 1;\\n                    CASE NextAction OF\\n                    1: ReqDown := TRUE;\\n                    2: ReqGrip := TRUE;\\n                    3: ReqUp := TRUE;\\n                    4: ReqRight := TRUE;\\n                    5: ReqDown := TRUE;\\n                    6: ReqRelease := TRUE;\\n                    7: ReqUp := TRUE;\\n                    8: ReqLeft := TRUE;\\n                    END_CASE\\n                END_IF\\n            ELSE\\n                CASE NextAction OF\\n                1: ReqDown := TRUE;\\n                2: ReqGrip := TRUE;\\n                3: ReqUp := TRUE;\\n                4: ReqRight := TRUE;\\n                5: ReqDown := TRUE;\\n                6: ReqRelease := TRUE;\\n                7: ReqUp := TRUE;\\n                8: ReqLeft := TRUE;\\n                END_CASE\\n            END_IF\\n        ELSE\\n            IF StartEdge AND UpLimitSwitch AND LeftLimitSwitch THEN\\n                Busy := TRUE;\\n                NextAction := 1;\\n                ReqDown := TRUE;\\n            END_IF\\n        END_IF\\n    END_CASE\\nEND_IF\\n\\nMoveDown := ReqDown AND EmergencyStop AND (SelectedMode <> 0) AND NOT ModeChanged AND NOT DownLimitSwitch;\\nMoveUp := ReqUp AND EmergencyStop AND (SelectedMode <> 0) AND NOT ModeChanged AND NOT UpLimitSwitch;\\nMoveLeft := ReqLeft AND EmergencyStop AND (SelectedMode <> 0) AND NOT ModeChanged AND NOT LeftLimitSwitch;\\nMoveRight := ReqRight AND EmergencyStop AND (SelectedMode <> 0) AND NOT ModeChanged AND NOT RightLimitSwitch;\\nActivateGrip := ReqGrip AND EmergencyStop AND (SelectedMode <> 0) AND NOT ModeChanged AND NOT GripLimitSwitch;\\nActivateRelease := ReqRelease AND EmergencyStop AND (SelectedMode <> 0) AND NOT ModeChanged AND NOT ReleaseLimitSwitch;\\n\\nPrevMode := SelectedMode;\\nFirstScan := FALSE;\\nStartPrev := Start;\",\"supporting_objects\":[]}","sequence_number":2231}

