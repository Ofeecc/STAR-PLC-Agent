event: response.output_text.done
data: {"type":"response.output_text.done","content_index":0,"item_id":"msg_02179466350227700000000000000000000ffffac155d727d41f8","output_index":1,"text":"{\n  \"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Mode : BOOL;\\n    ForwardButton : BOOL;\\n    ReverseButton : BOOL;\\n    SensorFeed : BOOL;\\n    SensorWash : BOOL;\\n    SensorWeight : BOOL;\\n    SensorFiring : BOOL;\\n    SensorOutput : BOOL;\\n    washComplete : BOOL;\\n    weightComplete : BOOL;\\n    weight : REAL;\\n    firingComplete : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    MotorForward : BOOL;\\n    MotorReverse : BOOL;\\n    kick : BOOL;\\n    CompletionLight : BOOL;\\n    firingTemp : REAL;\\nEND_VAR\\nVAR\\n    phase : E_ProductionPhase := E_ProductionPhase.WAIT_FEED;\\n    rejected : BOOL := FALSE;\\n    ModePrev : BOOL := FALSE;\\nEND_VAR\",\n  \"implementation\": \"IF Mode <> ModePrev THEN\\n    ModePrev := Mode;\\n    phase := E_ProductionPhase.WAIT_FEED;\\n    rejected := FALSE;\\n    kick := FALSE;\\n    CompletionLight := FALSE;\\nEND_IF\\n\\nIF NOT Mode THEN\\n    MotorForward := ForwardButton AND NOT ReverseButton;\\n    MotorReverse := ReverseButton AND NOT ForwardButton;\\n    kick := FALSE;\\n    CompletionLight := FALSE;\\n    phase := E_ProductionPhase.WAIT_FEED;\\n    rejected := FALSE;\\nELSE\\n    MotorReverse := FALSE;\\n\\n    CASE phase OF\\n        E_ProductionPhase.WAIT_FEED:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            rejected := FALSE;\\n            IF SensorFeed THEN\\n                MotorForward := TRUE;\\n                phase := E_ProductionPhase.MOVE_TO_WASH;\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_WASH:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorWash THEN\\n                MotorForward := FALSE;\\n                phase := E_ProductionPhase.WAIT_WASH;\\n            END_IF\\n\\n        E_ProductionPhase.WAIT_WASH:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF washComplete THEN\\n                MotorForward := TRUE;\\n                phase := E_ProductionPhase.MOVE_TO_WEIGHT;\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_WEIGHT:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorWeight THEN\\n                MotorForward := FALSE;\\n                phase := E_ProductionPhase.WAIT_WEIGHT;\\n            END_IF\\n\\n        E_ProductionPhase.WAIT_WEIGHT:\\n            MotorForward := FALSE;\\n            CompletionLight := FALSE;\\n            IF rejected THEN\\n                kick := TRUE;\\n                IF NOT SensorWeight THEN\\n                    kick := FALSE;\\n                    rejected := FALSE;\\n                    phase := E_ProductionPhase.WAIT_FEED;\\n                END_IF\\n            ELSE\\n                kick := FALSE;\\n                IF SensorWeight AND weightComplete THEN\\n                    IF (weight >= 100.0) AND (weight <= 200.0) THEN\\n                        firingTemp := 500.0 + (weight - 100.0) * 0.5;\\n                        MotorForward := TRUE;\\n                        phase := E_ProductionPhase.MOVE_TO_FIRING;\\n                    ELSE\\n                        kick := TRUE;\\n                        rejected := TRUE;\\n                    END_IF\\n                END_IF\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_FIRING:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorFiring THEN\\n                MotorForward := FALSE;\\n                phase := E_ProductionPhase.WAIT_FIRING;\\n            END_IF\\n\\n        E_ProductionPhase.WAIT_FIRING:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF firingComplete THEN\\n                MotorForward := TRUE;\\n                phase := E_ProductionPhase.MOVE_TO_OUTPUT;\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_OUTPUT:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorOutput THEN\\n                MotorForward := FALSE;\\n                CompletionLight := TRUE;\\n                phase := E_ProductionPhase.OUTPUT_DONE;\\n            END_IF\\n\\n        E_ProductionPhase.OUTPUT_DONE:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            IF SensorOutput THEN\\n                CompletionLight := TRUE;\\n            ELSE\\n                CompletionLight := FALSE;\\n                phase := E_ProductionPhase.WAIT_FEED;\\n            END_IF\\n    END_CASE\\nEND_IF\",\n  \"supporting_objects\": [\n    {\n      \"name\": \"E_ProductionPhase\",\n      \"kind\": \"DUT\",\n      \"declaration\": \"TYPE E_ProductionPhase :\\n(\\n    WAIT_FEED,\\n    MOVE_TO_WASH,\\n    WAIT_WASH,\\n    MOVE_TO_WEIGHT,\\n    WAIT_WEIGHT,\\n    MOVE_TO_FIRING,\\n    WAIT_FIRING,\\n    MOVE_TO_OUTPUT,\\n    OUTPUT_DONE\\n);\\nEND_TYPE\",\n      \"implementation\": \"\"\n    }\n  ]\n}","sequence_number":1784}

