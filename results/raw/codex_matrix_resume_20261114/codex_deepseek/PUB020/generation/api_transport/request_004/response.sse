ton\": false, \"SensorFeed\": false, \"SensorWash\": true, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 0.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": true, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": true, \"weightComplete\": false, \"weight\": 0.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": true, \"weight\": 99.9, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": true, \"weight\": 99.9, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": true, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": true, \"weight\": 150.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": true, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 99.9, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}]}, {\"name\": \"weight_100\", \"steps\": [{\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": true, \"SensorWash\": false, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 100.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": true, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 100.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": true, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": true, \"weightComplete\": false, \"weight\": 100.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 100.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": true, \"weight\": 100.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 500.0}}]}, {\"name\": \"weight_200\", \"steps\": [{\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": true, \"SensorWash\": false, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 200.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": true, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 200.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": true, \"SensorWeight\": false, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": true, \"weightComplete\": false, \"weight\": 200.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": false, \"weight\": 200.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": false, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 0.0}}, {\"inputs\": {\"Mode\": true, \"ForwardButton\": false, \"ReverseButton\": false, \"SensorFeed\": false, \"SensorWash\": false, \"SensorWeight\": true, \"SensorFiring\": false, \"SensorOutput\": false, \"washComplete\": false, \"weightComplete\": true, \"weight\": 200.0, \"firingComplete\": false}, \"expected\": {\"MotorForward\": true, \"MotorReverse\": false, \"kick\": false, \"CompletionLight\": false, \"firingTemp\": 550.0}}]}], \"source\": {\"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Mode : BOOL;\\n    ForwardButton : BOOL;\\n    ReverseButton : BOOL;\\n    SensorFeed : BOOL;\\n    SensorWash : BOOL;\\n    SensorWeight : BOOL;\\n    SensorFiring : BOOL;\\n    SensorOutput : BOOL;\\n    washComplete : BOOL;\\n    weightComplete : BOOL;\\n    weight : REAL;\\n    firingComplete : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    MotorForward : BOOL;\\n    MotorReverse : BOOL;\\n    kick : BOOL;\\n    CompletionLight : BOOL;\\n    firingTemp : REAL;\\nEND_VAR\\nVAR\\n    phase : E_ProductionPhase := E_ProductionPhase.WAIT_FEED;\\n    rejected : BOOL := FALSE;\\n    ModePrev : BOOL := FALSE;\\nEND_VAR\", \"implementation\": \"IF Mode <> ModePrev THEN\\n    ModePrev := Mode;\\n    phase := E_ProductionPhase.WAIT_FEED;\\n    rejected := FALSE;\\n    kick := FALSE;\\n    CompletionLight := FALSE;\\nEND_IF\\n\\nIF NOT Mode THEN\\n    MotorForward := ForwardButton AND NOT ReverseButton;\\n    MotorReverse := ReverseButton AND NOT ForwardButton;\\n    kick := FALSE;\\n    CompletionLight := FALSE;\\n    phase := E_ProductionPhase.WAIT_FEED;\\n    rejected := FALSE;\\nELSE\\n    MotorReverse := FALSE;\\n\\n    CASE phase OF\\n        E_ProductionPhase.WAIT_FEED:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            rejected := FALSE;\\n            IF SensorFeed THEN\\n                MotorForward := TRUE;\\n                phase := E_ProductionPhase.MOVE_TO_WASH;\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_WASH:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorWash THEN\\n                MotorForward := FALSE;\\n                phase := E_ProductionPhase.WAIT_WASH;\\n            END_IF\\n\\n        E_ProductionPhase.WAIT_WASH:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF washComplete THEN\\n                MotorForward := TRUE;\\n                phase := E_ProductionPhase.MOVE_TO_WEIGHT;\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_WEIGHT:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorWeight THEN\\n                MotorForward := FALSE;\\n                phase := E_ProductionPhase.WAIT_WEIGHT;\\n            END_IF\\n\\n        E_ProductionPhase.WAIT_WEIGHT:\\n            MotorForward := FALSE;\\n            CompletionLight := FALSE;\\n            IF rejected THEN\\n                kick := TRUE;\\n                IF NOT SensorWeight THEN\\n                    kick := FALSE;\\n                    rejected := FALSE;\\n                    phase := E_ProductionPhase.WAIT_FEED;\\n                END_IF\\n            ELSE\\n                kick := FALSE;\\n                IF SensorWeight AND weightComplete THEN\\n                    IF (weight >= 100.0) AND (weight <= 200.0) THEN\\n                        firingTemp := 500.0 + (weight - 100.0) * 0.5;\\n                        MotorForward := TRUE;\\n                        phase := E_ProductionPhase.MOVE_TO_FIRING;\\n                    ELSE\\n                        kick := TRUE;\\n                        rejected := TRUE;\\n                    END_IF\\n                END_IF\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_FIRING:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorFiring THEN\\n                MotorForward := FALSE;\\n                phase := E_ProductionPhase.WAIT_FIRING;\\n            END_IF\\n\\n        E_ProductionPhase.WAIT_FIRING:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF firingComplete THEN\\n                MotorForward := TRUE;\\n                phase := E_ProductionPhase.MOVE_TO_OUTPUT;\\n            END_IF\\n\\n        E_ProductionPhase.MOVE_TO_OUTPUT:\\n            MotorForward := TRUE;\\n            kick := FALSE;\\n            CompletionLight := FALSE;\\n            IF SensorOutput THEN\\n                MotorForward := FALSE;\\n                CompletionLight := TRUE;\\n                phase := E_ProductionPhase.OUTPUT_DONE;\\n            END_IF\\n\\n        E_ProductionPhase.OUTPUT_DONE:\\n            MotorForward := FALSE;\\n            kick := FALSE;\\n            IF SensorOutput THEN\\n                CompletionLight := TRUE;\\n            ELSE\\n                CompletionLight := FALSE;\\n                phase := E_ProductionPhase.WAIT_FEED;\\n            END_IF\\n    END_CASE\\nEND_IF\", \"supporting_objects\": [{\"name\": \"E_ProductionPhase\", \"kind\": \"DUT\", \"declaration\": \"TYPE E_ProductionPhase :\\n(\\n    WAIT_FEED,\\n    MOVE_TO_WASH,\\n    WAIT_WASH,\\n    MOVE_TO_WEIGHT,\\n    WAIT_WEIGHT,\\n    MOVE_TO_FIRING,\\n    WAIT_FIRING,\\n    MOVE_TO_OUTPUT,\\n    OUTPUT_DONE\\n);\\nEND_TYPE\", \"implementation\": \"\"}]}}","sequence_number":5255}

