op\": true, \"opeMode\": true, \"valveAStart\": true, \"valveBStart\": false, \"valveCStart\": false, \"valveDStart\": false, \"mixMotorStart\": false, \"autoStart\": false, \"processMode\": false, \"levelSensor\": 0, \"mixMotorComplete\": false}, \"expected\": {\"valveARun\": false, \"valveBRun\": false, \"valveCRun\": false, \"valveDRun\": false, \"mixMotorRun\": false}}, {\"inputs\": {\"estop\": true, \"opeMode\": true, \"valveAStart\": false, \"valveBStart\": false, \"valveCStart\": false, \"valveDStart\": false, \"mixMotorStart\": false, \"autoStart\": true, \"processMode\": false, \"levelSensor\": 0, \"mixMotorComplete\": false}, \"expected\": {\"valveARun\": true, \"valveBRun\": false, \"valveCRun\": false, \"valveDRun\": false, \"mixMotorRun\": false}}, {\"inputs\": {\"estop\": true, \"opeMode\": true, \"valveAStart\": false, \"valveBStart\": false, \"valveCStart\": false, \"valveDStart\": false, \"mixMotorStart\": false, \"autoStart\": false, \"processMode\": false, \"levelSensor\": 50, \"mixMotorComplete\": false}, \"expected\": {\"valveARun\": false, \"valveBRun\": true, \"valveCRun\": false, \"valveDRun\": false, \"mixMotorRun\": false}}, {\"inputs\": {\"estop\": true, \"opeMode\": false, \"valveAStart\": false, \"valveBStart\": false, \"valveCStart\": false, \"valveDStart\": true, \"mixMotorStart\": false, \"autoStart\": false, \"processMode\": false, \"levelSensor\": 50, \"mixMotorComplete\": false}, \"expected\": {\"valveARun\": false, \"valveBRun\": false, \"valveCRun\": false, \"valveDRun\": false, \"mixMotorRun\": false}}, {\"inputs\": {\"estop\": true, \"opeMode\": false, \"valveAStart\": false, \"valveBStart\": false, \"valveCStart\": false, \"valveDStart\": true, \"mixMotorStart\": false, \"autoStart\": false, \"processMode\": false, \"levelSensor\": 50, \"mixMotorComplete\": false}, \"expected\": {\"valveARun\": false, \"valveBRun\": false, \"valveCRun\": false, \"valveDRun\": false, \"mixMotorRun\": false}}, {\"inputs\": {\"estop\": true, \"op