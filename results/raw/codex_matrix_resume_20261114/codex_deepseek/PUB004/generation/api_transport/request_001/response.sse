data: {"type":"response.function_call_arguments.done","item_id":"fc_02179466162562700000000000000000000ffffac1508846196a3","output_index":2,"arguments":"{\"cases\": [{\"name\": \"debounce_runtime\", \"steps\": [{\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#200ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#0ns\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#200ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#0ns\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#200ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#100ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#200ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#200ms\"}}]}, {\"name\": \"estop_requalification\", \"steps\": [{\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#0ns\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#100ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#200ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": false, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#200ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#200ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#300ms\"}}]}, {\"name\": \"viscosity_loss_requalification\", \"steps\": [{\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#0ns\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#100ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": false, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#100ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#100ms\"}}, {\"dt_ms\": 100, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#100ms\", \"CycleTime\": \"T#100ms\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#200ms\"}}]}, {\"name\": \"maintenance_threshold\", \"steps\": [{\"dt_ms\": 1800000000, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#1ms\", \"CycleTime\": \"T#500h\"}, \"expected\": {\"VFD_RUN\": false, \"PUMP_MAINT_DUE\": false, \"PUMP_RUNTIME_ACC\": \"LTIME#0ns\"}}, {\"dt_ms\": 1800000000, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#1ms\", \"CycleTime\": \"T#500h\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": true, \"PUMP_RUNTIME_ACC\": \"LTIME#500h\"}}, {\"dt_ms\": 1800000000, \"inputs\": {\"VISCOSITY_OK\": true, \"PASTE_E_STOP_NC\": true, \"DebounceTime\": \"T#1ms\", \"CycleTime\": \"T#500h\"}, \"expected\": {\"VFD_RUN\": true, \"PUMP_MAINT_DUE\": true, \"PUMP_RUNTIME_ACC\": \"LTIME#1000h\"}}]}], \"source\": {\"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    VISCOSITY_OK : BOOL;\\n    PASTE_E_STOP_NC : BOOL;\\n    DebounceTime : TIME;\\n    CycleTime : TIME;\\nEND_VAR\\nVAR_OUTPUT\\n    VFD_RUN : BOOL := FALSE;\\n    PUMP_MAINT_DUE : BOOL := FALSE;\\n    PUMP_RUNTIME_ACC : LTIME := LTIME#0ns;\\nEND_VAR\\nVAR\\n    debounceElapsed : LTIME := LTIME#0ns;\\n    viscosityQualified : BOOL := FALSE;\\nEND_VAR\", \"implementation\": \"IF NOT PASTE_E_STOP_NC THEN\\n    debounceElapsed := LTIME#0ns;\\n    viscosityQualified := FALSE;\\nELSIF NOT VISCOSITY_OK THEN\\n    debounceElapsed := LTIME#0ns;\\n    viscosityQualified := FALSE;\\nELSE\\n    IF debounceElapsed >= TIME_TO_LTIME(DebounceTime) THEN\\n        viscosityQualified := TRUE;\\n    END_IF;\\nEND_IF;\\n\\nVFD_RUN := PASTE_E_STOP_NC AND VISCOSITY_OK AND viscosityQualified;\\n\\nIF VFD_RUN THEN\\n    PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + TIME_TO_LTIME(CycleTime);\\nEND_IF;\\n\\nPUMP_MAINT_DUE := PUMP_RUNTIME_ACC >= LTIME#500h;\\n\\nIF PASTE_E_STOP_NC AND VISCOSITY_OK AND NOT viscosityQualified THEN\\n    debounceElapsed := debounceElapsed + TIME_TO_LTIME(CycleTime);\\nEND_IF;\", \"supporting_objects\": []}}","sequence_number":2772}

