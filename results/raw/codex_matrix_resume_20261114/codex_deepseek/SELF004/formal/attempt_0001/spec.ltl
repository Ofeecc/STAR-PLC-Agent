LTLSPEC NAME SELF004.P_init := init;

-- Property: SELF004.P1
-- Description: Jam wins over Reset and Start.
LTLSPEC NAME SELF004.P1 := G(Jam -> (Fault & !Belt & !Complete));

-- Property: SELF004.P2
-- Description: Fault requires an explicit clear operation.
LTLSPEC NAME SELF004.P2 := G((qFault & !Reset) -> Fault);

-- Property: SELF004.P3
