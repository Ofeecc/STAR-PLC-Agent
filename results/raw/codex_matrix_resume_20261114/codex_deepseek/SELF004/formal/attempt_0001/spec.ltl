LTLSPEC NAME SELF004.P4 := G((qIdle & !Jam & !Reset & !Stop & Start & !AtExit) -> Belt);

-- Property: SELF004.P5
-- Description: Exit arrival stops indexing in the same scan.
LTLSPEC NAME SELF004.P5 := G((qMoving & AtExit & !Jam & !Reset & !Stop) -> (Complete & !Belt));

-- Property: SELF004.P6
-- Description: Movement excludes completion and fault outputs.
LTLSPEC NAME SELF004.P6 := G(!(Belt & (Complete | Fault)));

-- Property: SELF004.P7
-- Description: A latched jam remains until a cleared-jam reset, or forever if no such reset occurs; this does not assume eventual reset.
LTLSPEC NAME SELF004.P7 := G(Fault -> (G Fault | (Fault U (!Jam & Reset))));

-- Property: SELF004.P8
-- Description: Prevents degenerate implementations that refuse to stop or drop MOVING/COMPLETE prematurely.
LTLSPEC NAME SELF004.P8 := G((!Jam & !Reset & !qFault & Stop -> (!Belt & !Complete & !Fault)) & (qIdle & !Jam & !Reset & (!Start | AtExit) -> (!Belt & !Complete & !Fault)) & (qMoving & !Jam & !Reset & !Stop & !AtExit -> (Belt & !Complete & !Fault)) & (qComplete & !Jam & !Reset & !Stop -> (Complete & !Belt & !Fault)));

-- Property: SELF004.P9
-- Description: Eliminates remaining false-positive satisfaction paths on P1..P8.
LTLSPEC NAME SELF004.P9 := G(!(Belt & Complete) & (!(Jam | qFault) -> !Fault) & ((qIdle | qFault | Stop | Reset) -> !Complete));

-- Property: SELF004.COMPLETE
-- Description: Every constrained ACTUAL output satisfies the exact pinned input-driven reference transition and comparison policy. Finite observations can falsify this predicate; no completed unbounded proof is claimed.
LTLSPEC NAME SELF004.COMPLETE := G(CompleteBehavior);
