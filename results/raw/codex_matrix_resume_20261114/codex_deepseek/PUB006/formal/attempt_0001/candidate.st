FUNCTION_BLOCK FB_Task
VAR_INPUT
    DO_LOW : BOOL;
    AERATION_E_STOP_NC : BOOL;
END_VAR
VAR_OUTPUT
    BLOWER_RUN : BOOL := FALSE;
    AERATION_BLOWER_CYCLE_COUNT : UINT := 0;
END_VAR
VAR
    StartTimer : TON;
    Permit : BOOL;
    RunPrevious : BOOL;
END_VAR

Permit := DO_LOW AND AERATION_E_STOP_NC;
StartTimer(IN := Permit, PT := T#5S);
BLOWER_RUN := Permit AND StartTimer.Q;

IF BLOWER_RUN AND NOT RunPrevious THEN
    AERATION_BLOWER_CYCLE_COUNT := AERATION_BLOWER_CYCLE_COUNT + 1;
END_IF

RunPrevious := BLOWER_RUN;
END_FUNCTION_BLOCK
