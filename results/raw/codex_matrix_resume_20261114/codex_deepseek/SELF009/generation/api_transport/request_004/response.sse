data: {"type":"response.function_call_arguments.done","item_id":"fc_02179466408813000000000000000000000ffffac1536a1b38ed7","output_index":2,"arguments":"{\"source\": {\"declaration\": \"{attribute 'analysis' := 'off'}\\nFUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    PartPulse : BOOL;\\n    Reset : BOOL;\\n    Target : USINT;\\nEND_VAR\\nVAR_OUTPUT\\n    Count : USINT := 0;\\n    Complete : BOOL := FALSE;\\n    Error : BOOL := FALSE;\\nEND_VAR\\nVAR\\n    previous_pulse : BOOL := FALSE;\\nEND_VAR\", \"implementation\": \"Error := (Target < 1) OR (Target > 20);\\n\\nIF Error OR Reset THEN\\n    Count := 0;\\n    Complete := FALSE;\\nELSE\\n    IF PartPulse AND NOT previous_pulse AND (Count < Target) THEN\\n        Count := Count + 1;\\n    ELSIF Count > Target THEN\\n        Count := Target;\\n    END_IF;\\n    Complete := (Count >= Target);\\nEND_IF;\\n\\nprevious_pulse := PartPulse;\", \"supporting_objects\": []}, \"cases\": [{\"name\": \"edge_reset_saturation_invalid\", \"steps\": [{\"inputs\": {\"PartPulse\": false, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": true, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 1, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": true, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 1, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": false, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 1, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": true, \"Reset\": true, \"Target\": 3}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": true, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": false, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": true, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 1, \"Complete\": false, \"Error\": false}}, {\"inputs\": {\"PartPulse\": false, \"Reset\": false, \"Target\": 1}, \"expected\": {\"Count\": 1, \"Complete\": true, \"Error\": false}}, {\"inputs\": {\"PartPulse\": false, \"Reset\": false, \"Target\": 21}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": true}}, {\"inputs\": {\"PartPulse\": true, \"Reset\": false, \"Target\": 0}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": true}}, {\"inputs\": {\"PartPulse\": false, \"Reset\": false, \"Target\": 3}, \"expected\": {\"Count\": 0, \"Complete\": false, \"Error\": false}}]}]}","sequence_number":1565}

