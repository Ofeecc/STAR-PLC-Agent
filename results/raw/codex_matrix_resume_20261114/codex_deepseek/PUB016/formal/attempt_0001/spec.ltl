LTLSPEC NAME PUB016.P6 := (G(moving -> F arrive) & G(processing -> F completion)) -> G(started -> F done);

-- Property: PUB016.P7
-- Description: Forbids starting automatic transport without a detected product at station 1.
LTLSPEC NAME PUB016.P7 := G(station1Start_rejected -> stop);

-- Property: PUB016.COMPLETE
