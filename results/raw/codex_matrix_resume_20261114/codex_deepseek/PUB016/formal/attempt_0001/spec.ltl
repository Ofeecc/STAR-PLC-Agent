-- Property: PUB016.P1
-- Description: Both directions can never run together.
LTLSPEC NAME PUB016.P1 := G(!(left & right));

-- Property: PUB016.P2
-- Description: The target/current station order determines direction.
LTLSPEC NAME PUB016.P2 := G((higher -> (right & !left)) & (lower -> (left & !right)));

-- Property: PUB016.P3
