data: {"type":"response.output_text.done","content_index":0,"item_id":"msg_02179466331067400000000000000000000ffffac155d72c99b2a","output_index":1,"text":"{\n  \"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    enqueue : BOOL;\\n    dequeue : BOOL;\\n    reset : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    elementCount : DINT;\\n    status : WORD;\\nEND_VAR\\nVAR_IN_OUT\\n    item : VARIANT;\\n    buffer : VARIANT;\\nEND_VAR\\nVAR\\n    initialized : BOOL := FALSE;\\n    count : DINT := 0;\\n    head : DINT := 0;\\n    tail : DINT := 0;\\n    capacity : DINT := 0;\\n    elementSize : DINT := 0;\\n    pBuffer : POINTER TO BYTE;\\n    pItem : POINTER TO BYTE;\\n    prevEnqueue : BOOL := FALSE;\\n    prevDequeue : BOOL := FALSE;\\n    enqueueEdge : BOOL;\\n    dequeueEdge : BOOL;\\n    index : DINT;\\n    offset : DINT;\\nEND_VAR\",\n  \"implementation\": \"status := 16#0000;\\n\\nIF NOT initialized THEN\\n    elementSize := item.diSize;\\n    IF elementSize <= 0 THEN\\n        elementSize := buffer.diElementSize;\\n    END_IF;\\n    IF buffer.diElementCount > 0 THEN\\n        capacity := buffer.diElementCount;\\n    ELSIF elementSize > 0 THEN\\n        capacity := buffer.diSize / elementSize;\\n    ELSE\\n        capacity := 0;\\n    END_IF;\\n    pBuffer := buffer.pData;\\n    count := 0;\\n    head := 0;\\n    tail := 0;\\n    initialized := TRUE;\\nEND_IF;\\n\\npItem := item.pData;\\nenqueueEdge := enqueue AND NOT prevEnqueue;\\ndequeueEdge := dequeue AND NOT prevDequeue;\\n\\nIF reset THEN\\n    count := 0;\\n    head := 0;\\n    tail := 0;\\n    status := 16#0000;\\nELSIF enqueueEdge AND NOT dequeueEdge THEN\\n    IF (capacity <= 0) OR (count >= capacity) THEN\\n        status := 16#8002;\\n    ELSE\\n        offset := tail * elementSize;\\n        FOR index := 0 TO elementSize - 1 DO\\n            pBuffer[offset + index] := pItem[index];\\n        END_FOR;\\n        tail := tail + 1;\\n        IF tail >= capacity THEN\\n            tail := 0;\\n        END_IF;\\n        count := count + 1;\\n    END_IF;\\nELSIF dequeueEdge AND NOT enqueueEdge THEN\\n    IF (capacity <= 0) OR (count <= 0) THEN\\n        status := 16#8001;\\n    ELSE\\n        offset := head * elementSize;\\n        FOR index := 0 TO elementSize - 1 DO\\n            pItem[index] := pBuffer[offset + index];\\n        END_FOR;\\n        head := head + 1;\\n        IF head >= capacity THEN\\n            head := 0;\\n        END_IF;\\n        count := count - 1;\\n        IF count = 0 THEN\\n            head := 0;\\n            tail := 0;\\n        END_IF;\\n    END_IF;\\nEND_IF;\\n\\nelementCount := count;\\nprevEnqueue := enqueue;\\nprevDequeue := dequeue;\",\n  \"supporting_objects\": [\n    {\n      \"name\": \"VARIANT\",\n      \"kind\": \"DUT\",\n      \"declaration\": \"TYPE VARIANT :\\nSTRUCT\\n    pData : POINTER TO BYTE;\\n    diSize : DINT;\\n    diElementSize : DINT;\\n    diElementCount : DINT;\\nEND_STRUCT\\nEND_TYPE\",\n      \"implementation\": \"\"\n    }\n  ]\n}","sequence_number":1447}

