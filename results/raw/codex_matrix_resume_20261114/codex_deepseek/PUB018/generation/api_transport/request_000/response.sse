data: {"type":"response.function_call_arguments.done","item_id":"fc_02179466311834600000000000000000000ffffac15fd08e34df9","output_index":1,"arguments":"{\"source\": {\"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    enqueue : BOOL;\\n    dequeue : BOOL;\\n    reset : BOOL;\\nEND_VAR\\nVAR_OUTPUT\\n    elementCount : DINT;\\n    status : WORD;\\nEND_VAR\\nVAR_IN_OUT\\n    item : VARIANT;\\n    buffer : VARIANT;\\nEND_VAR\\nVAR\\n    initialized : BOOL := FALSE;\\n    head : DINT := 0;\\n    tail : DINT := 0;\\n    capacity : DINT := 0;\\n    elementSize : DINT := 0;\\n    pBuffer : POINTER TO BYTE;\\n    pItem : POINTER TO BYTE;\\n    prevEnqueue : BOOL := FALSE;\\n    prevDequeue : BOOL := FALSE;\\n    enqueueEdge : BOOL;\\n    dequeueEdge : BOOL;\\n    index : DINT;\\n    offset : DINT;\\nEND_VAR\", \"implementation\": \"status := 16#0000;\\n\\nIF NOT initialized THEN\\n    elementSize := TO_DINT(__VARINFO(item).diSize);\\n    IF elementSize > 0 THEN\\n        capacity := TO_DINT(__VARINFO(buffer).diSize) / elementSize;\\n    ELSE\\n        capacity := 0;\\n    END_IF;\\n    pBuffer := __VARINFO(buffer).pData;\\n    head := 0;\\n    tail := 0;\\n    elementCount := 0;\\n    initialized := TRUE;\\nEND_IF;\\n\\nenqueueEdge := enqueue AND NOT prevEnqueue;\\ndequeueEdge := dequeue AND NOT prevDequeue;\\n\\nIF reset THEN\\n    elementCount := 0;\\n    head := 0;\\n    tail := 0;\\n    status := 16#0000;\\nELSIF enqueueEdge AND NOT dequeueEdge THEN\\n    IF elementCount >= capacity THEN\\n        status := 16#8002;\\n    ELSE\\n        pItem := __VARINFO(item).pData;\\n        offset := tail * elementSize;\\n        FOR index := 0 TO elementSize - 1 DO\\n            pBuffer[offset + index] := pItem[index];\\n        END_FOR;\\n        tail := tail + 1;\\n        IF tail >= capacity THEN\\n            tail := 0;\\n        END_IF;\\n        elementCount := elementCount + 1;\\n    END_IF;\\nELSIF dequeueEdge AND NOT enqueueEdge THEN\\n    IF elementCount <= 0 THEN\\n        status := 16#8001;\\n    ELSE\\n        pItem := __VARINFO(item).pData;\\n        offset := head * elementSize;\\n        FOR index := 0 TO elementSize - 1 DO\\n            pItem[index] := pBuffer[offset + index];\\n        END_FOR;\\n        head := head + 1;\\n        IF head >= capacity THEN\\n            head := 0;\\n        END_IF;\\n        elementCount := elementCount - 1;\\n        IF elementCount = 0 THEN\\n            head := 0;\\n            tail := 0;\\n        END_IF;\\n    END_IF;\\nEND_IF;\\n\\nprevEnqueue := enqueue;\\nprevDequeue := dequeue;\", \"supporting_objects\": []}}","sequence_number":4366}

