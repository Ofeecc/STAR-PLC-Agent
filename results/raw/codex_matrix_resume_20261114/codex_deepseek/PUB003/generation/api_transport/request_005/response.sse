data: {"type":"response.function_call_arguments.done","item_id":"fc_02179466102898100000000000000000000ffffac15573555ff90","output_index":2,"arguments":"{\"source\": {\"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Value : REAL;\\n    hiLevel : REAL;\\n    loLevel : REAL;\\n    hystWindow : REAL;\\nEND_VAR\\nVAR_OUTPUT\\n    hiAlarm : BOOL;\\n    loAlarm : BOOL;\\n    {attribute 'no_check'}\\n    error : BOOL;\\n    status : WORD;\\nEND_VAR\", \"implementation\": \"error := FALSE;\\nstatus := 16#0000;\\n\\nIF loLevel >= hiLevel THEN\\n    error := TRUE;\\n    status := 16#8001;\\n    RETURN;\\nEND_IF\\n\\nIF hystWindow >= (hiLevel - loLevel) THEN\\n    error := TRUE;\\n    status := 16#8002;\\n    RETURN;\\nEND_IF\\n\\nIF Value > hiLevel THEN\\n    hiAlarm := TRUE;\\nELSIF Value < (hiLevel - hystWindow) THEN\\n    hiAlarm := FALSE;\\nEND_IF\\n\\nIF Value < loLevel THEN\\n    loAlarm := TRUE;\\nELSIF Value > (loLevel + hystWindow) THEN\\n    loAlarm := FALSE;\\nEND_IF\", \"supporting_objects\": []}, \"cases\": [{\"name\": \"high_hysteresis\", \"steps\": [{\"inputs\": {\"Value\": 50.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 101.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 95.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 89.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}]}, {\"name\": \"low_hysteresis\", \"steps\": [{\"inputs\": {\"Value\": 50.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": -1.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": true, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 5.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": true, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 11.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}]}, {\"name\": \"errors_and_recovery\", \"steps\": [{\"inputs\": {\"Value\": 50.0, \"hiLevel\": 0.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": true, \"status\": 32769}}, {\"inputs\": {\"Value\": 101.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 100.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": true, \"status\": 32770}}, {\"inputs\": {\"Value\": 101.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 50.0, \"hiLevel\": 0.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": true, \"status\": 32769}}]}]}","sequence_number":5551}

