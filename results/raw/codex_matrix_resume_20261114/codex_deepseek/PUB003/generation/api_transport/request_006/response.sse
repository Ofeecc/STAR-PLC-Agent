data: {"type":"response.output_item.done","output_index":2,"item":{"arguments":"{\"source\": {\"declaration\": \"FUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Value : REAL;\\n    hiLevel : REAL;\\n    loLevel : REAL;\\n    hystWindow : REAL;\\nEND_VAR\\n{attribute 'no_check'}\\n{attribute 'qualified_only'}\\nVAR_OUTPUT\\n    hiAlarm : BOOL;\\n    loAlarm : BOOL;\\n    error : BOOL;\\n    status : WORD;\\nEND_VAR\", \"implementation\": \"THIS^.error := FALSE;\\nTHIS^.status := 16#0000;\\n\\nIF loLevel >= hiLevel THEN\\n    THIS^.error := TRUE;\\n    THIS^.status := 16#8001;\\n    RETURN;\\nEND_IF\\n\\nIF hystWindow >= (hiLevel - loLevel) THEN\\n    THIS^.error := TRUE;\\n    THIS^.status := 16#8002;\\n    RETURN;\\nEND_IF\\n\\nIF Value > hiLevel THEN\\n    THIS^.hiAlarm := TRUE;\\nELSIF Value < (hiLevel - hystWindow) THEN\\n    THIS^.hiAlarm := FALSE;\\nEND_IF\\n\\nIF Value < loLevel THEN\\n    THIS^.loAlarm := TRUE;\\nELSIF Value > (loLevel + hystWindow) THEN\\n    THIS^.loAlarm := FALSE;\\nEND_IF\", \"supporting_objects\": []}, \"cases\": [{\"name\": \"high_hysteresis\", \"steps\": [{\"inputs\": {\"Value\": 50.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 101.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 95.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 89.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}]}, {\"name\": \"low_hysteresis\", \"steps\": [{\"inputs\": {\"Value\": 50.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": -1.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": true, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 5.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": true, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 11.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": false, \"status\": 0}}]}, {\"name\": \"errors_and_recovery\", \"steps\": [{\"inputs\": {\"Value\": 50.0, \"hiLevel\": 0.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": true, \"status\": 32769}}, {\"inputs\": {\"Value\": 101.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 100.0}, \"expected\": {\"hiAlarm\": false, \"loAlarm\": false, \"error\": true, \"status\": 32770}}, {\"inputs\": {\"Value\": 101.0, \"hiLevel\": 100.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": false, \"status\": 0}}, {\"inputs\": {\"Value\": 50.0, \"hiLevel\": 0.0, \"loLevel\": 0.0, \"hystWindow\": 10.0}, \"expected\": {\"hiAlarm\": true, \"loAlarm\": false, \"error\": true, \"status\": 32769}}]}]}","call_id":"call_00_kx0j3j9rxwbwbntnyj3jf1m5","name":"simulate_st","type":"function_call","id":"fc_02179466108474000000000000000000000ffffac154bf2c15354","status":"completed","namespace":"mcp__plc"},"sequence_number":2415}

