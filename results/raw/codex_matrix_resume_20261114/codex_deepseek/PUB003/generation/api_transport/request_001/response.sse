data: {"type":"response.output_item.done","output_index":2,"item":{"arguments":"{\"source\": {\"declaration\": \"{attribute 'suppresswarning' := 'SA0027'}\\nFUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Value : REAL;\\n    hiLevel : REAL;\\n    loLevel : REAL;\\n    hystWindow : REAL;\\nEND_VAR\\nVAR_OUTPUT\\n    hiAlarm : BOOL;\\n    loAlarm : BOOL;\\n    error : BOOL;\\n    status : WORD;\\nEND_VAR\", \"implementation\": \"error := FALSE;\\nstatus := 16#0000;\\n\\nIF loLevel >= hiLevel THEN\\n    error := TRUE;\\n    status := 16#8001;\\n    RETURN;\\nEND_IF\\n\\nIF hystWindow >= (hiLevel - loLevel) THEN\\n    error := TRUE;\\n    status := 16#8002;\\n    RETURN;\\nEND_IF\\n\\nIF Value > hiLevel THEN\\n    hiAlarm := TRUE;\\nELSIF Value < (hiLevel - hystWindow) THEN\\n    hiAlarm := FALSE;\\nEND_IF\\n\\nIF Value < loLevel THEN\\n    loAlarm := TRUE;\\nELSIF Value > (loLevel + hystWindow) THEN\\n    loAlarm := FALSE;\\nEND_IF\", \"supporting_objects\": []}}","call_id":"call_00_08sgu57bfmzzunsz4blzbmqw","name":"compile_st","type":"function_call","id":"fc_02179466082528700000000000000000000ffffac1557443abd83","status":"completed","namespace":"mcp__plc"},"sequence_number":1309}

