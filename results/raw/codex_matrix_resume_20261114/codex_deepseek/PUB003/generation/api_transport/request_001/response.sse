data: {"type":"response.function_call_arguments.done","item_id":"fc_02179466082528700000000000000000000ffffac1557443abd83","output_index":2,"arguments":"{\"source\": {\"declaration\": \"{attribute 'suppresswarning' := 'SA0027'}\\nFUNCTION_BLOCK FB_Task\\nVAR_INPUT\\n    Value : REAL;\\n    hiLevel : REAL;\\n    loLevel : REAL;\\n    hystWindow : REAL;\\nEND_VAR\\nVAR_OUTPUT\\n    hiAlarm : BOOL;\\n    loAlarm : BOOL;\\n    error : BOOL;\\n    status : WORD;\\nEND_VAR\", \"implementation\": \"error := FALSE;\\nstatus := 16#0000;\\n\\nIF loLevel >= hiLevel THEN\\n    error := TRUE;\\n    status := 16#8001;\\n    RETURN;\\nEND_IF\\n\\nIF hystWindow >= (hiLevel - loLevel) THEN\\n    error := TRUE;\\n    status := 16#8002;\\n    RETURN;\\nEND_IF\\n\\nIF Value > hiLevel THEN\\n    hiAlarm := TRUE;\\nELSIF Value < (hiLevel - hystWindow) THEN\\n    hiAlarm := FALSE;\\nEND_IF\\n\\nIF Value < loLevel THEN\\n    loAlarm := TRUE;\\nELSIF Value > (loLevel + hystWindow) THEN\\n    loAlarm := FALSE;\\nEND_IF\", \"supporting_objects\": []}}","sequence_number":1308}

