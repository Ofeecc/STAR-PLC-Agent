-- Property: PUB002.P1
-- Description: The rising mask identifies only 0-to-1 bits.
LTLSPEC NAME PUB002.P1 := G(risingBits = (value AND NOT prev));

-- Property: PUB002.P2
-- Description: The falling mask identifies only 1-to-0 bits.
LTLSPEC NAME PUB002.P2 := G(fallingBits = (prev AND NOT value));

-- Property: PUB002.P3
-- Description: A bit cannot rise and fall in one scan.
LTLSPEC NAME PUB002.P3 := G((risingBits AND fallingBits)=0);

-- Property: PUB002.P4
-- Description: Both counts equal their mask population.
LTLSPEC NAME PUB002.P4 := G((noOfRisingBits=popcount(risingBits)) & (noOfFallingBits=popcount(fallingBits)));

