FUNCTION_BLOCK FB_Task
VAR_INPUT
    VISCOSITY_OK : BOOL;
    PASTE_E_STOP_NC : BOOL;
    DebounceTime : TIME;
    CycleTime : TIME;
END_VAR
VAR_OUTPUT
    VFD_RUN : BOOL := FALSE;
    PUMP_MAINT_DUE : BOOL := FALSE;
    PUMP_RUNTIME_ACC : LTIME := LTIME#0ns;
END_VAR
VAR
    DebounceTimer : TON;
END_VAR

DebounceTimer(IN := VISCOSITY_OK AND PASTE_E_STOP_NC, PT := DebounceTime);
VFD_RUN := VISCOSITY_OK AND PASTE_E_STOP_NC AND DebounceTimer.Q;
IF VFD_RUN THEN
    PUMP_RUNTIME_ACC := PUMP_RUNTIME_ACC + TIME_TO_LTIME(CycleTime);
END_IF;
PUMP_MAINT_DUE := PUMP_RUNTIME_ACC >= LTIME#500h;
END_FUNCTION_BLOCK
