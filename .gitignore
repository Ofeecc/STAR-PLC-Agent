__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments and local lockfile (team rule: uv.lock stays local)
.venv/
venv/
env/
ENV/
uv.lock

# Linter and test caches
.ruff_cache/
.pytest_cache/
.mypy_cache/

# Sensitive and environment credentials
.env
.env.*
!.env.example
*.key
*APIKEY*
configs/runtime.local.json

# Local runtime & temporary files
.local/
.local_tmp/
.superpowers/
*.tmp
*.log
*.bak

# IDE & OS specific
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build & heavy archive artifacts
codesys/installers/
report/build/
presentation/build/
submission/*.zip
refs/

